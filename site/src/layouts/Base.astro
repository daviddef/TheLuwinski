---
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import BookHead from "@daviddef/archive-kit/components/BookHead.astro";
import BookFoot from "@daviddef/archive-kit/components/BookFoot.astro";
import book from "../data/book.json";
import { u } from "../lib/url.js";
/* `noindex` is the page-level switch for a page ABOUT a living person: the kit's sitemap tool and this
   archive's search index (tools/build-search.py) both leave out a page that noindexes itself. Every
   person in the register has a page since 16 October 2026 and a LIVING person's passes noindex and
   structured={false} (tools/check-living.py fails a living person's page that lacks the one or carries
   the other). `about` is { name, birthDate, deathDate } for a page about a person who is NOT living;
   it reaches the kit's JsonLd as a Person and is never passed for the living. */
/* `ownHeading` is for a page whose content draws its own h1, subtitle and lede (the shared people page,
   kit PersonPage: it carries the name, the life dates and the one sentence inside its own header). Base
   then renders none of the three, so the document keeps exactly one h1, and `subtitle` is used for the
   description only. */
/* `noAutolink` puts data-no-autolink on <main>, so the build-time name linker (kit/tools/autolink.py) leaves the whole page
   alone. Used where a link would be wrong or is already there: the person pages (a chart of relatives, many of whom
   have no page of their own, and the person's own name, which would link to itself), the people index and the register
   (every row already links its person; the Noted column is the source tree's own text about other people). */
const { title, subtitle, lede, hero, structured = true, noindex = false, about = undefined, ownHeading = false, noAutolink = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ["Start", [["", "The archive"], ["/tree", "The tree"], ["/timeline", "The Timeline"], ["/dna", "The DNA"], ["/1948", "Nineteen forty-eight"]]],
  ["Our line", [["/derrick", "Derrick"], ["/leonard", "Leonard Wear"], ["/wear-line", "Where the Wear line stands"], ["/kurt", "Kurt"], ["/ivone", "Ivone"], ["/leibholz", "The Leibholz brothers"]]],
  ["The families", [["/families", "The families"], ["/families/luwinski", "Luwinski"], ["/families/leibholz", "Leibholz"], ["/families/wear", "Wear"], ["/families/thimm", "Thimm"], ["/families/castle", "Castle"], ["/families/hawkins", "Hawkins"], ["/families/giddins", "Giddins"], ["/families/larkin", "Larkin"], ["/families/figueiredo", "Figueiredo"], ["/families/schmul", "Schmul"], ["/families/bloom", "Bloom"], ["/families/wallis", "Wallis"]]],
  ["Places", [["/east-prussia", "East Prussia"], ["/mozambique", "Mozambique"], ["/australia", "Australia"], ["/atlas", "Atlas"]]],
  ["People & names", [["/register", "The register"], ["/bloodline", "Blood relatives"], ["/people", "All the people"], ["/lines", "The lines of the name"], ["/names", "Her names"]]],
  ["Evidence", [["/method", "Method"], ["/sources", "Sources"], ["/searched", "What Has Been Read"], ["/open-questions", "Open Questions"], ["/errands", "Errands"], ["/worklist", "The work list"], ["/corrections", "Corrections"], ["/changes", "What changed"]]],
  ["Investigations", [["/status", "Status"]]],
];
const navFlat = nav.flatMap(([, links]) => links);
const here = Astro.url.pathname.replace(base, '').replace(/\/$/, '');

/* THE HEAD TAGS THAT SAY WHICH ARCHIVE THIS IS.
   Added 17 September 2026 because the tab strip showed this site as a generic
   "G" while every sibling showed its own initial. The cause was two absences:
   there was no favicon file at all, and nothing in this head ever linked one.
   With no icon declared the browser falls back to the shared github.io origin,
   which is what the G came from.

   The siblings get these from the kit's SocialHead, which reads name, accent
   and url out of archives.json by BASE_URL. THIS ARCHIVE WAS TAKEN OUT OF THE RING
   ON 16 SEPTEMBER 2026 at David's instruction ("not related") and so the values
   below were stated here instead. David has since decided that Luwinski IS
   included: it is the eighth entry in the kit's archives.json (kit 6df1715) and
   this layout draws the ring (SiblingArchives, in the footer). The values stay
   stated here, because SocialHead is not used by this layout. */
const SITE = 'The Luwinski Archive';
const ACCENT = '#9A4B2B';
/* THE ORIGIN IS STATED HERE AND NOWHERE ELSE, which is why it had to be changed
   by hand on 12 October 2026 when this archive moved to its own domain. The
   siblings take theirs from the kit's archives.json via SocialHead; THIS ARCHIVE
   WAS NOT IN THAT FILE when this was written (see the note above), so the origin
   lives in this constant, and it still does. A scratch build caught it: base and the
   links were already right and canonical still read daviddef.github.io, which would
   have told every search engine that the canonical home of this site is a URL that
   301-redirects back to it. */
const ORIGIN = 'https://luwinski.defranceski.com';
const LINE = 'An evidence-first archive of the Luwinski, Wear, Castle and Figueiredo families.';
const p = Astro.url.pathname.replace(/\/+$/, '');
const canonical = ORIGIN + (/\.[a-z0-9]{2,5}$/i.test(p) ? p : p + '/');
const isHome = Astro.url.pathname.replace(/\/+$/, '') === base;
const full = title === SITE ? SITE : title + ' \u2014 ' + SITE;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'The Luwinski Archive' ? title : title + ' — The Luwinski Archive'}</title>
  <meta name="description" content={subtitle || LINE} />
  <link rel="icon" href={base + '/favicon.svg'} type="image/svg+xml" />
  <meta name="theme-color" content={ACCENT} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={subtitle || LINE} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={subtitle || LINE} />
  {/* Structured data from the kit's JsonLd, as the sibling archives emit it. Every field is one the
      head and the page already show: the title, the description, the address, the site. Nothing is
      passed as `about` except on the page of a person who is not living, where it is the name and
      the dates the page itself prints (a living person is named, with relationship, town and
      country, and has no structured data; the twenty ancestors' pages are left to the prose
      until their dates are ISO). A page that is ABOUT a living person passes structured={false} and
      emits nothing: the standard is no structured data for the living, so /derrick/ carries none. */}
  {structured && <JsonLd type={isHome ? "WebSite" : "Article"} name={title} description={subtitle || LINE}
          url={canonical} site={SITE} about={structured ? about : undefined} />}  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href={base + '/styles.css'} />
  <style is:global>
    :root {
      --ink: #1b1a17; --ink-soft: #55514a; --ink-faint: #6b675f; /* was #857f75: 3.6-3.9:1 on the ground and panel, AA needs 4.5 */
      --ground: #f7f5f0; --panel: #fffdf8; --rule: #ddd7cb;
      --accent: #7a2e1f; --accent-soft: #a8563f;
      --doc: #2f5d50; --inf: #6b5a12; --disp: #8a2f2f; --open: #4a4a52; --eng: #3b5b78;
      /* The kit's WorkList paints its five statuses with fixed hex colours; these are the same hues
         at a depth that reads on this page's surfaces, applied by the overrides further down. */
      --wl-running: #1e5f8c; --wl-next: #98660f; --wl-blocked: #b04a16; --wl-done: #12703f; --wl-struck: #707070;
      /* Kit components that paint a surface (PersonTree's nodes) ask for --paper; it was never
         defined here, so they fell back to #fff, a white tile under pale text in the dark scheme. */
      --paper: var(--panel);
      /* Aliases so the shared archive-kit component CSS resolves against this
         archive's own palette rather than shipping a second set of colours. */
      --ink-2: var(--ink-soft); --ink-3: var(--ink-faint);
      --rule-strong: var(--ink-faint); --panel-2: var(--ground);
      --accent-wash: color-mix(in srgb, var(--accent) 12%, var(--panel));
      --serif: "EB Garamond", Georgia, "Times New Roman", serif;
      --sans: "Libre Franklin", "Helvetica Neue", Arial, sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
      --measure: 58rem;   /* reading column */
      --wide: 64rem;      /* tables, cards, panels */
      --bleed: 9rem;      /* extra width for diagrams, only when there is room */
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --ink: #ece7dd; --ink-soft: #b3aca0; --ink-faint: #959087;
        --ground: #14130f; --panel: #1c1a16; --rule: #35312a;
        --accent: #d98b72; --accent-soft: #b5674f;
        --doc: #7fb8a4; --inf: #cbb45f; --disp: #d98080; --open: #a5a5b0; --eng: #5a86ae;
        --wl-running: #2b88c8; --wl-next: #e9a020; --wl-blocked: #d95b1b; --wl-done: #189554; --wl-struck: #828282;
        color-scheme: dark;
      }
    }
    :root[data-theme="dark"] {
      --ink: #ece7dd; --ink-soft: #b3aca0; --ink-faint: #959087;
      --ground: #14130f; --panel: #1c1a16; --rule: #35312a;
      --accent: #d98b72; --accent-soft: #b5674f;
      --doc: #7fb8a4; --inf: #cbb45f; --disp: #d98080; --open: #a5a5b0; --eng: #5a86ae;
      --wl-running: #2b88c8; --wl-next: #e9a020; --wl-blocked: #d95b1b; --wl-done: #189554; --wl-struck: #828282;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--ground); color: var(--ink);
      font: 16px/1.62 "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      -webkit-font-smoothing: antialiased;
    }
    .wrap { max-width: var(--wide); margin: 0 auto; padding: 0 1.5rem; }
    /* Diagrams may reach past the wide column, but only when the viewport can
       afford it — and always from the same left edge as everything else. */
    .bleed { width: 100%; }
    @media (min-width: 84rem) { .bleed { width: calc(100% + var(--bleed)); } }
    /* Document scans sit on the same left edge and the same right edge as the prose:
       the browser's default 40px figure margin otherwise indents them out of line. */
    figure.doc-scan { margin: 1.6rem 0; max-width: var(--measure); }
    figure.doc-scan img { width: 100%; display: block; border: 1px solid var(--rule); border-radius: 3px; }
    figure.doc-scan figcaption { margin-top: .6rem; }
    /* A document and its transcription: the Portuguese as written on the page,
       and a plain English rendering beside it, so a reader who cannot read the
       hand can still check this archive's claims against the words. */
    .xlat { display: grid; grid-template-columns: 1fr 1fr; gap: .2rem 1.8rem;
      max-width: var(--measure); margin: 1.1rem 0 1.8rem;
      border-top: 1px solid var(--rule); padding-top: .9rem; }
    .xlat > div > h4 { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .6875rem;
      letter-spacing: .11em; text-transform: uppercase; color: var(--ink-faint);
      margin: 0 0 .5rem; font-weight: 600; max-width: none; }
    .xlat p { margin: 0 0 .45rem; font-size: .9rem; line-height: 1.5; max-width: none; }
    .xlat .pt p, .xlat .de p { font-style: italic; color: var(--ink-soft); }
    .xlat .unclear { font-style: normal; color: var(--ink-faint); }
    @media (max-width: 760px) { .xlat { grid-template-columns: 1fr; gap: .2rem; }
      .xlat .en { margin-top: .9rem; } }
    /* Headings share the reading measure so the page has one right edge for prose. */
    h2, h3 { max-width: var(--measure); }
    /* Masthead, after the Defranceschi archive: a sticky bar, a serif wordmark
       with the second word in italic accent, grouped dropdowns instead of
       twenty-three flat links, and a search pill on the right. */
    .masthead { border-bottom: 1px solid var(--rule); background: var(--panel);
      position: sticky; top: 0; z-index: 60; }
    .sitein { display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; padding-top: .7rem; padding-bottom: .7rem; }
    .masthead a.brand { font-size: 1.15rem; font-weight: 600; letter-spacing: -.01em;
      color: var(--ink); text-decoration: none; white-space: nowrap; }
    .masthead a.brand em { font-style: italic; font-weight: 400; color: var(--accent); }
    nav.topnav { display: flex; align-items: center; gap: 1px; flex-wrap: nowrap; }
    nav.topnav details.menu { position: relative; }
    nav.topnav summary { list-style: none; cursor: pointer;
      font-family: ui-sans-serif, system-ui, sans-serif; font-size: .78rem;
      color: var(--ink-soft); padding: .35rem .55rem; border-radius: 999px;
      white-space: nowrap; border: 1px solid transparent; }
    nav.topnav summary::-webkit-details-marker { display: none; }
    nav.topnav summary::after { content: ""; display: inline-block; margin-left: .38rem;
      width: 5px; height: 5px; border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); opacity: .55; }
    nav.topnav summary:hover { color: var(--ink); }
    nav.topnav details[open] summary { color: var(--accent); border-color: var(--rule); }
    nav.topnav .dropdown { position: absolute; top: calc(100% + 8px); left: 0; min-width: 13rem;
      z-index: 70; background: var(--panel); border: 1px solid var(--rule); border-radius: 12px;
      box-shadow: 0 18px 44px rgba(10,12,16,.18); padding: .4rem; display: flex; flex-direction: column; }
    nav.topnav .dropdown a { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .84rem;
      color: var(--ink-soft); text-decoration: none; padding: .4rem .6rem; border-radius: 8px; white-space: nowrap; }
    nav.topnav .dropdown a:hover { color: var(--accent); }
    nav.topnav .dropdown a.on { color: var(--ink); font-weight: 600; }
    .findbtn { display: inline-block; font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: .76rem; line-height: 1; text-decoration: none; margin-left: .55rem;
      color: var(--ground); background: var(--accent); padding: .45rem .85rem; border-radius: 999px; white-space: nowrap; }
    .drawerbox { display: none; }
    .drawerbox > summary { list-style: none; cursor: pointer; font-size: .8rem;
      border: 1px solid var(--rule); border-radius: 999px; padding: .38rem .8rem; color: var(--ink); }
    .drawerbox > summary::-webkit-details-marker { display: none; }
    .drawer { position: absolute; left: 0; right: 0; background: var(--panel);
      border-bottom: 1px solid var(--rule); padding: .8rem 1rem 1.2rem; max-height: 72vh; overflow: auto; z-index: 65; }
    .drawer .dgrp { padding: .5rem 0; border-bottom: 1px solid var(--rule); }
    .drawer .dgrp:last-child { border-bottom: 0; }
    .drawer .gl { display: block; font-size: .6875rem; font-weight: 600; letter-spacing: .16em;
      text-transform: uppercase; color: var(--ink-faint); margin-bottom: .35rem; }
    .drawer a { display: inline-block; font-size: .88rem; color: var(--ink-soft);
      text-decoration: none; padding: .25rem .8rem .25rem 0; }
    .drawer a.on { color: var(--accent); font-weight: 600; }
    @media (max-width: 62rem) {
      nav.topnav { display: none; }
      .drawerbox { display: block; }
    }
    main { padding: 2.6rem 0 4rem; }
    h1 { font-size: clamp(1.9rem, 4.2vw, 3rem); line-height: 1.08; margin: 0 0 .4rem; font-weight: 600; letter-spacing: -.015em; }
    .sub { color: var(--ink-soft); font-size: 1.02rem; margin: 0 0 1.7rem; max-width: var(--measure); }
    .lede { font-size: 1.16rem; line-height: 1.55; max-width: var(--measure); margin: 0 0 2rem; }
    h2 { font-size: 1.32rem; margin: 2.9rem 0 .7rem; font-weight: 600; letter-spacing: -.01em; }
    h3 { font-size: 1.02rem; margin: 1.8rem 0 .5rem; font-weight: 600; }
    p, ul, ol { max-width: var(--measure); }
    p { margin: 0 0 1.05rem; }
    li { margin-bottom: .45rem; }
    a { color: var(--accent); text-underline-offset: 2px; }
    /* A name linked to its person by the build-time pass (kit/tools/autolink.py, wired in package.json, 18 October 2026).
       It carries no Astro scoped-style attribute, so it takes the global link style; stated here so it is the same as a
       link typed by hand and cannot drift if the line above changes. */
    a[data-autolink] { color: var(--accent); text-underline-offset: 2px; }
    blockquote { margin: 1.4rem 0; padding: .2rem 0 .2rem 1.2rem; border-left: 3px solid var(--rule); color: var(--ink-soft); font-style: italic; max-width: var(--measure); }
    .scroll { overflow-x: auto; margin: 1.4rem 0; border: 1px solid var(--rule); background: var(--panel); border-radius: 3px; }
    /* A LONG UNBREAKABLE STRING OVERFLOWS ITS PARAGRAPH, and a block's own box stays
       container-width while the word runs out of it — so no element-size check finds
       it and the whole page scrolls sideways on a phone. Found 13 October 2026 on
       /worklist/ (+204px), /searched/ (+73) and /sources/ (+65): file names, URLs and
       reference codes in notes. break-word rather than anywhere in prose, so table
       columns keep their natural minimum width; anywhere only on code, which is where
       the URLs live. */
    main p, main li, main td, main dd, main figcaption, main blockquote, main .sr-w, main .sr-meta { overflow-wrap: break-word; }
    main code { overflow-wrap: anywhere; }
    table { border-collapse: collapse; width: 100%; font-size: .87rem; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; }
    th, td { text-align: left; padding: .55rem .8rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
    th { font-weight: 600; font-size: .74rem; letter-spacing: .07em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; }
    tbody tr:last-child td { border-bottom: 0; }
    /* TABLE CELLS KEEP THEIR WORDS WHOLE (17 October 2026 layout audit: 15 of 50 sampled pages had cells
       squeezed into stacks of one or two letters, dates three lines high, file names at 90px). Cause: in
       an auto-layout table a short column (a date, a count, a file name) is the first to give way when a
       long prose column wants the room. break-word above keeps each column's minimum at its longest word;
       the floor below keeps a date or a short code from being squeezed to that minimum. Tables of five
       columns or fewer get 7.5rem, enough for "29 Sept 2026" on one line; wider tables get 6rem, and a
       table that still cannot fit scrolls inside its .scroll box rather than the page. Phones and print are left
       to wrap, as before. A panel that holds a table runs the full width of the column the table uses. */
    main td, main th { word-break: normal; hyphens: manual; }
    @media screen and (min-width: 48rem) {
      main td { min-width: 6rem; }
      main table:not(:has(tr > :nth-child(6))) td { min-width: 7.5rem; }
      .panel:has(.scroll) { max-width: none; }
    }
    .tag { display: inline-block; font-family: ui-sans-serif, system-ui, sans-serif; font-size: .6875rem; letter-spacing: .1em; text-transform: uppercase; padding: .15rem .45rem; border: 1px solid currentColor; border-radius: 2px; white-space: nowrap; }
    .tag.doc { color: var(--doc); } .tag.inf { color: var(--inf); } .tag.disp { color: var(--disp); } .tag.open { color: var(--open); }
    .panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 3px; padding: 1.2rem 1.4rem; margin: 1.6rem 0; max-width: var(--measure); }
    .panel > :last-child { margin-bottom: 0; }
    .panel h3 { margin-top: 0; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; margin: 1.8rem 0; max-width: none; }
    .card { background: var(--panel); border: 1px solid var(--rule); border-radius: 3px; padding: 1.1rem 1.2rem; }
    .card a { text-decoration: none; font-weight: 600; }
    .card p { font-size: .9rem; color: var(--ink-soft); margin: .35rem 0 0; }
    .stat { font-family: ui-sans-serif, system-ui, sans-serif; }
    .stat b { display: block; font-size: 1.7rem; font-weight: 600; letter-spacing: -.02em; }
    .stat span { font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); }
    footer { border-top: 1px solid var(--rule); padding: 1.6rem 0 3rem; font-size: .82rem; color: var(--ink-faint); }
    footer p { max-width: 46rem; }
    .kv { display: grid; grid-template-columns: minmax(7rem, auto) 1fr; gap: .3rem 1.1rem; font-size: .92rem; max-width: var(--measure); margin: 1.2rem 0; }
    .kv dt { color: var(--ink-faint); font-family: ui-sans-serif, system-ui, sans-serif; font-size: .76rem; letter-spacing: .05em; text-transform: uppercase; padding-top: .2rem; }
    .kv dd { margin: 0; }
    /* Source links. A reference that can be verified in one click is linked;
       one that cannot says so, rather than looking the same as one that can. */
    a.src { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--accent-soft); }
    a.src:hover { color: var(--accent); border-bottom-style: solid; }
    a.src::after { content: " \2197"; font-size: .72em; vertical-align: .25em; color: var(--accent-soft); }
    .unsourced { border-bottom: 1px dotted var(--ink-faint); cursor: help; }
    /* Chromosome segment map (/dna/). Colours come from the theme tokens so it
       works in light and dark without a second palette. */
    .segmap { margin: 1.8rem 0 1.2rem; }
    .segmap svg { display: block; width: 100%; height: auto; }
    .segmap .trk { fill: var(--rule); opacity: .55; }
    .segmap .a { fill: var(--accent); }
    .segmap .b { fill: var(--doc); }
    .segmap .ov { fill: none; stroke: var(--inf); stroke-width: 1.6; }
    .segmap .cl { font: 600 11px ui-sans-serif, system-ui, sans-serif; fill: var(--ink-faint); }
    .segmap figcaption { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; margin-top: .75rem; color: var(--ink-soft); max-width: none; }
    .segmap .key { display: inline-flex; align-items: center; gap: .4rem; }
    .segmap .key i { width: 1.1rem; height: .5rem; border-radius: 2px; display: inline-block; flex: none; }
    .segmap .key i.ka { background: var(--accent); }
    .segmap .key i.kb { background: var(--doc); }
    .segmap .key i.kov { background: none; border: 1.6px solid var(--inf); height: .85rem; }
    /* Optional hero band on the home page. Rendered only when the file exists. */
    /* The hero band. Sized and layered after the Defranceschi archive: a full-bleed
       plate, a gradient that darkens only the lower third so the sky stays open,
       and the title set over it rather than beneath it. */
    .hero { position: relative; border-bottom: 1px solid var(--rule); background: #1b1a17; overflow: hidden; }
    .hero img { display: block; width: 100%; height: clamp(300px, 48vw, 560px);
      object-fit: cover; object-position: center 58%; }
    .hero .cap { position: absolute; left: 0; right: 0; bottom: 0;
      background: linear-gradient(to top, rgba(14,13,11,.90), rgba(14,13,11,.52) 46%, rgba(14,13,11,.06) 78%, transparent); }
    .hero .cap .wrap { padding-top: 3.2rem; padding-bottom: 1.5rem; }
    .hero .kick { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .6875rem;
      letter-spacing: .2em; text-transform: uppercase; color: #E9C489; margin: 0; }
    .hero h1 { color: #FBF8F1; font-size: clamp(1.9rem, 5vw, 3.5rem); line-height: 1.04;
      margin: .45rem 0 0; max-width: 20ch; font-weight: 600; letter-spacing: -.018em; }
    .hero .sub { color: #E2DCD0; font-size: clamp(.9rem, 1.5vw, 1.02rem); margin: .7rem 0 0;
      max-width: 60ch; line-height: 1.5; }
    .hero-note { display: block; padding: .5rem 0 0; font-size: .72rem; color: var(--ink-faint); }
    /* Phones. The caption block is nearly as tall as the plate, so at 375px the
       text had covered the whole painting and there was no picture left to see.
       Give the image more height, take the headline down, and tighten the sub. */
    @media (max-width: 34rem) {
      .hero img { height: 26rem; object-position: 42% 60%; }
      .hero .cap .wrap { padding-top: 1.6rem; padding-bottom: 1.1rem; }
      .hero h1 { font-size: 1.5rem; line-height: 1.12; max-width: 17ch; }
      .hero .sub { font-size: .82rem; line-height: 1.45; margin-top: .5rem; }
      .hero .kick { font-size: .6875rem; letter-spacing: .16em; }
    }
    /* Phones: four full-width stat cards is a great deal of scrolling for
       four numbers. Two across reads better and still fits at 320px. */
    @media (max-width: 34rem) {
      .cards { grid-template-columns: repeat(2, 1fr); gap: .6rem; }
      .card { padding: .85rem .9rem; }
      .stat b { font-size: 1.45rem; }
      .stat span { font-size: .67rem; letter-spacing: .04em; }
      .wrap { padding: 0 1rem; }
      /* Tags are nowrap so a two-word label never splits. A few are long
         enough to push a phone page sideways on their own, so let them wrap here. */
      .tag { white-space: normal; }
    }
    /* A SIZE FLOOR OF 11px FOR LABELS. The kit's components set their small uppercase labels at 9px
       to 9.5px in their own scoped styles, which this archive cannot edit; the selectors below match
       them from outside, one element heavier, so they win without !important. Added 16 October 2026
       after the audit counted 43 pages with text under 10px. */
    body main :is(.ch-k, .ch-lab, .tl-kind, .tl-k, .tl-b, .tl-d, .tl-lab, .cx-t, .cx-lab, .sp-k, .sp-n .mono,
      .sp-hl, .qs-dl dt, .qs-lab, .ft-lab, .chip, .ptree .mar, .ptree .via, .sr-tag, .dc-k, .gy-k, .hh-lab,
      .hh-lk, .mg-ca, .mg-badge, .mg-dl dt, .nl-one i, .syn-lab, .syn-card h4, .lane-conf, .rr-lane,
      .omit-rel, .rel) { font-size: 11px; }
    main:focus { outline: none; }
    /* THE BOOK's running head and foot (kit BookHead / BookFoot) take their width and side padding from
       these two lines, so they sit on the same left edge as the page and its masthead. */
    :root { --bk-width: var(--wide); }
    body .bk-head .bk-row { padding-left: 1.5rem; padding-right: 1.5rem; }
    /* The foot has a rule above it, so it takes the page column's own width (the .wrap's content box) rather
       than padding inside a wider box: the rule then runs exactly as wide as the text above it. */
    body .bk-foot.bk-foot { width: calc(100% - 3rem); max-width: calc(var(--wide) - 3rem); padding-left: 0; padding-right: 0; }
    @media (max-width: 34rem) { body .bk-head .bk-row { padding-left: 1rem; padding-right: 1rem; } body .bk-foot.bk-foot { width: calc(100% - 2rem); } }
    /* styles.css pins the Search button's text to #fff with !important, which is 2.7:1 on the pale
       accent of the dark scheme. This sheet loads after it, so the same weight wins. */
    .findbtn { color: var(--ground) !important; }
    /* WorkList status colours, from inline style attributes in the kit, so !important is the only way
       to reach them. Matched on the hex the kit writes. */
    .wl [style*="#1E5F8C" i] { color: var(--wl-running) !important; --c: var(--wl-running) !important; }
    .wl [style*="#E9A020" i] { color: var(--wl-next) !important; --c: var(--wl-next) !important; }
    .wl [style*="#B04A16" i] { color: var(--wl-blocked) !important; --c: var(--wl-blocked) !important; }
    .wl [style*="#12703F" i] { color: var(--wl-done) !important; --c: var(--wl-done) !important; }
    .wl [style*="#7A7A7A" i] { color: var(--wl-struck) !important; --c: var(--wl-struck) !important; }
    body .wl .wl-stale { color: var(--wl-blocked); }
    .muted { color: var(--ink-soft); }
    .small { font-size: .85rem; }
  </style>
</head>
<body class={hero ? "has-hero" : undefined}>
  <SkipLink />
  <header class="masthead"><div class="wrap sitein">
    <a class="brand" href={base + '/'}>The Luwinski <em>Archive</em></a>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="dropdown">
            {links.map(([h, l]) => (
              <a href={base + (h ? h + '/' : '/')} class={here === h ? 'on' : undefined}>{l}</a>
            ))}
          </div>
        </details>
      ))}
      <a class="findbtn" href={base + '/search/'}>Search</a>
    </nav>
    <details class="drawerbox">
      <summary>Menu</summary>
      <div class="drawer">
        {nav.map(([label, links]) => (
          <div class="dgrp"><span class="gl">{label}</span>
            {links.map(([h, l]) => (
              <a href={base + (h ? h + '/' : '/')} class={here === h ? 'on' : undefined}>{l}</a>
            ))}
          </div>
        ))}
        <div class="dgrp"><a href={base + '/search/'}>Search</a></div>
      </div>
    </details>
  </div></header>
  {/* THE BOOK (17 October 2026): the running head sits below the site header on every page and the
      Previous / Next above the footer. src/data/book.json places every page; kit/tools/checkbook.py fails the
      build on one nobody placed. The width of the book's head and foot is set in the style block below. */}
  <BookHead book={book} u={u} />
  {hero && (
    <figure class="hero" style="margin:0">
      <img src={hero.src} alt={hero.alt} />
      <div class="cap"><div class="wrap">
        {hero.kick && <p class="kick">{hero.kick}</p>}
        <h1>{hero.heading || title}</h1>
        {(hero.sub || subtitle) && <p class="sub">{hero.sub || subtitle}</p>}
      </div></div>
    </figure>
  )}
  {hero && <div class="wrap"><figcaption class="hero-note">{hero.caption}</figcaption></div>}
  <main id="main" tabindex="-1" {...(noAutolink ? { 'data-no-autolink': '' } : {})}><div class="wrap">
    {/* Where a hero carries the page's h1, this one is not rendered at all: it used to be
        printed and hidden with CSS, which left two h1 elements in the document. */}
    {!hero && !ownHeading && <h1>{title}</h1>}
    {!hero && !ownHeading && subtitle && <p class="sub">{subtitle}</p>}
    {lede && !ownHeading && <p class="lede">{lede}</p>}
    <slot />
  </div></main>
  <BookFoot book={book} u={u} />
  <footer><div class="wrap">
    {/* The other archives, as one line of small cards (kit SiblingArchives, read from the kit's archives.json,
        which now holds this archive as its eighth entry; the component leaves this archive out, so the ring
        never links to itself). It is site-level: it names the other archives and nobody in this one, and
        it carries nothing about a person, so it changes no withholding. */}
    <SiblingArchives />
    <p><strong>A living person (80 or younger, with no death recorded) is named with their relationships and their town and country, and nothing more.</strong>
    No dates, no records, no photograph. Lynn Derrick Luwinski is named with his parents only. A removal
    request is honoured within days, without argument and without requiring a reason.</p>
    <p>Every claim carries a confidence and a source. Corrections are the most valuable thing you can send.</p>
    {/* The siblings pass this component `thisArchive?.counter` out of the kit's
        archives.json. This archive is deliberately not in that file (see the
        note above the head tags), so the code is stated here, the same way
        SITE and ACCENT are. GoatCounter site: theluwinski. (The archive IS now in that
        file, as the eighth entry; the code stays stated here.) */}
    <VisitCount code="theluwinski" />
  </div></footer>
</body>
</html>

---
/* The box is one component in the kit, shared by every archive.

   This page carried 85 lines of its own — a fetch, a ranker and a renderer —
   and the kit's component says why that was a problem: "each archive had its
   own — 91, 107, 107, 126 and 142 lines of the same idea, so every
   improvement had to be made five times or it silently applied to one site."
   This archive was the eighth and last holdout.

   The index changed with it. It emitted page/url/heading/text and now emits
   the estate's k/t/s/h/q, which maps one for one — only `q`, the folded
   haystack the shared box ranks on, is new. tools/check-search.py reads both
   spellings on purpose, so the gate keeps working across the change rather
   than going quiet on the build that makes it.

   What stays here is what belongs to this archive: how it describes itself,
   and the things worth trying. */
import Base from '../layouts/Base.astro';
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from '../lib/url.js';

const hints = [
  ["Schöneberg", "the Berlin street the family left"],
  ["Auschwitz", "where three of the brothers were murdered"],
  ["Figueiredo", "Ivone's own name, recovered in 2026"],
  ["Halsey", "the DNA cluster that named a father"],
  ["1948", "the marriage, and the divorce four months later"],
  ["Sauerbaum", "the East Prussian village"],
];
---
<Base title="Search"
  subtitle="Everything in the archive, in one index"
  lede="Type a name, a street, a year, a ship. The index is built from the rendered pages, so what you can search is exactly what a reader can see — and nothing that the living-persons rule removed.">

  <section class="blk">
    <Search base={u("/")} hints={hints}
            placeholder="Schöneberg · Auschwitz · Figueiredo · 1948 · Aveiro · Halsey" />
  </section>
</Base>

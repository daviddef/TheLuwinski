---
/* What this archive has asked of other people, and when each may be chased.
 *
 * 11 October 2026. This page was hand-drawn. Seven of the eight archives in
 * the estate draw their errands queue with the kit's Errands component, and
 * this was the last holdout, so checkpages failed the build that added it.
 *
 * THE GRADE STAYS THIS ARCHIVE'S OWN. It ranks a letter by WHEN IT MAY BE
 * CHASED, computed from an interval chosen for the recipient — which is a
 * different question from Defranceski's (what would the answer buy),
 * D'Arcy's (where has the request got to) and Lerena's (has anybody
 * replied). The component takes the grouping, the grade and its wording as
 * given, the same contract the rest of the estate works to.
 *
 * AND THREE LETTERS HAD BEEN ANSWERED WITHOUT THE PAGE SAYING SO. letters.json
 * has carried `answered` and `outcome` on three rows since 25 September;
 * the old mapping read `ack` and `ackNote` and nothing else. So Koszalin —
 * answered in five lines with a negative, signed, on 16 September — printed
 * an em dash under «Heard back», and was counted as silent and as due to be
 * chased. The data was right and the page was wrong, which is the fault
 * checkrows.py exists for: the mapping in the page, not the component,
 * decides what a reader sees.
 */
import Base from '../layouts/Base.astro';
import { md } from '@daviddef/archive-kit/lib/md.js';
import Errands from '@daviddef/archive-kit/components/Errands.astro';
import { u } from '../lib/url.js';
import data from '../data/letters.json';

const day = 86400000;
const today = new Date();
const fmt = (d) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB',
  { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

/* The page recomputes on every build, so the dates below are live rather than
   written down once and forgotten. `n` is the order sent and does not move. */
const rows = data.rows.map((r, i) => {
  const sent = new Date(r.sent + 'T00:00:00Z');
  const due = new Date(sent.getTime() + r.chase * day);
  return {
    ...r,
    n: i + 1,
    waited: Math.floor((today - sent) / day),
    left: Math.ceil((due - today) / day),
    dueOn: due.toISOString().slice(0, 10),
  };
});

/* AN ACKNOWLEDGEMENT IS NOT AN ANSWER and the two are kept apart here, which
   is the one thing the footnote at the bottom of this page has always said:
   an answered letter is off the chase clock, an acknowledged one is not and
   its chase date does not move. */
/* DRAFTED AND NOT YET SENT. These used to live as prose inside work list rows,
   which is the wrong place for them: a drafted letter is an errand, and this is
   the errands page. They carry no sent date and no chase interval, so they are
   deliberately NOT part of `rows` above — putting them there would give every
   one of them a NaN clock. */
const drafts = (data.drafts ?? []);
const toSend = drafts.filter((d) => d.state !== 'superseded');
const dead = drafts.filter((d) => d.state === 'superseded');

const answered = rows.filter((r) => r.answered);
const open = rows.filter((r) => !r.answered).sort((a, b) => a.left - b.left);
const due = open.filter((r) => r.left <= 0);
const waiting = open.filter((r) => r.left > 0);
const acked = open.filter((r) => r.ack).length;

const STATE = {
  answered: ['Answered', 'var(--doc)'],
  due: ['Due to be chased', 'var(--disp)'],
  waiting: ['Inside its interval', 'var(--open)'],
};

/* The kit's row has no slot of its own for an outcome or a chase date, so both
   lead the slot that exists — the same move D'Arcy made when its statement of
   stakes had nowhere to go. A line nobody can read is not published. */
const why = (r, state) => {
  const bits = [];
  if (state === 'answered') {
    bits.push(`<strong>Answered ${fmt(r.answered)}.</strong> ${md(r.outcome)}`);
  } else if (state === 'due') {
    bits.push(`<strong>${r.left === 0 ? 'Due to be chased today' : `${-r.left} days overdue`}.</strong> `
      + `Waited ${r.waited} days against an interval of ${r.chase}.`);
  } else {
    bits.push(`<strong>Chase from ${fmt(r.dueOn)}</strong>, in ${r.left} days — `
      + `waited ${r.waited} of ${r.chase}.`);
  }
  if (r.ack) {
    bits.push(`<span class="muted"><strong>Acknowledged ${fmt(r.ack)}.</strong> ${md(r.ackNote)}`
      + `${state === 'answered' ? '' : ' An acknowledgement is not an answer and this date does not move.'}</span>`);
  }
  if (r.acknowledged) bits.push(`<span class="muted"><strong>Our thanks:</strong> ${md(r.acknowledged)}</span>`);
  if (r.followup) bits.push(`<strong>Followed up.</strong> ${md(r.followup)}`);
  return bits.join('<br />');
};

const toRows = (list, state) => list.map((r) => ({
  n: r.n,
  what: md(r.what),
  who: `<strong>${md(r.who)}</strong> · ${md(r.addr)}`,
  sent: fmt(r.sent),
  ref: md(r.thread),
  why: why(r, state),
  stateLabel: STATE[state][0],
  colour: STATE[state][1],
}));

/* 9 October 2026's lesson from D'Arcy, applied here: a count that is retyped
   is a claim that can go stale silently. The prose below said «fifteen
   letters» against eighteen rows in the data under it. It is computed now. */
const NUM = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
             'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen',
             'eighteen', 'nineteen', 'twenty'];
const word = (n) => (n < NUM.length ? NUM[n] : String(n));

const groups = [
  ['Answered, and kept', answered, 'answered',
    'Off the chase clock. The answer is printed in full, because a negative that cost a letter is worth as much as a hit.'],
  ['Due to be chased', due, 'due',
    'The interval chosen for this recipient has run out.'],
  ['Out, and still inside its interval', waiting, 'waiting',
    'Chasing these now would be chasing too early.'],
];
---
<Base title="Errands"
  subtitle={`${toSend.length} drafted and not yet sent · ${rows.length} sent — ${answered.length} answered, `
    + `${acked} acknowledged but not yet answered, ${open.length - acked} silent, and `
    + `${due.length === 0 ? 'none due to be chased' : `${due.length} due to be chased`}`}
  lede={data.note}>

  <div class="panel">
    <h3>Why this page exists</h3>
    <p>
      This archive has {word(rows.length)} letters out for its own research alone &mdash; more again in the sibling archives that share the mailbox &mdash; and <strong>had no schedule for chasing any of them</strong>,
      which means they get chased either too early, which annoys archivists, or never, which is worse.
      It had already sent one correspondent two emails in four hours and a second correspondent a
      duplicate enquiry it had forgotten making.
    </p>
    <p>
      So each letter now carries <strong>an interval chosen for the recipient</strong>, not a single
      global one. A parish office open three hours a day is not a commercial researcher. A national
      archive in another hemisphere is not a man who has quoted for work.
      <strong>The page recomputes on every build</strong>, so the dates below are live rather than
      written down once and forgotten.
    </p>
  </div>

  <section>
    <h2>Drafted, and not yet sent</h2>
    <p class="small muted">
      <strong>{word(toSend.length)} letters are written and waiting on David.</strong> They are kept
      here rather than in the work list, because a letter that exists and has not gone out is an
      errand and not a research question. <strong>This archive drafts; it does not send.</strong>
      Each one is a file under <code>requests/</code> in the repository.
    </p>
    <div class="scroll"><table>
      <thead><tr><th>To</th><th>What it asks</th><th>Before sending</th></tr></thead>
      <tbody>
        {toSend.map((d) => (
          <tr>
            <td><strong set:html={d.who} /><br /><code class="small">{d.file}</code></td>
            <td set:html={d.what} />
            <td class="small">{d.note ? <span set:html={d.note} /> : <span class="muted">—</span>}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    {dead.length > 0 && (
      <p class="small">
        <strong>And {dead.length === 1 ? 'one draft must not be sent' : `${dead.length} drafts must not be sent`}.</strong>
        {dead.map((d) => (
          <span> <strong set:html={d.who} /> — <span set:html={d.what} /> <em>The file is kept
          rather than deleted, so that nobody writes it again.</em></span>
        ))}
      </p>
    )}
  </section>

  <div class="panel">
    <h3>The address check that did not work <span class="tag disp">Rule replaced</span></h3>
    <p>
      This archive&rsquo;s standing rule was <em>&ldquo;MX check before sending any email&rdquo;</em>.
      On 15 September all twenty-six addresses the project has used were re-resolved and audited
      against the six that have actually failed. <strong>MX caught one of the six.</strong>
    </p>
    <div class="scroll"><table>
      <thead><tr><th>Address</th><th>MX said</th><th>What happened</th></tr></thead>
      <tbody>
        <tr><td><code>ahm@mail.exercito.pt</code></td><td><strong>no MX</strong></td><td><span class="tag doc">Caught</span> NXDOMAIN bounce</td></tr>
        <tr><td><code>sandfdoc@mweb.co.za</code></td><td>live</td><td>550 relay access denied</td></tr>
        <tr><td><code>enquiries@dac.gov.za</code></td><td>live</td><td>NXDOMAIN, from DSAC&rsquo;s own gateway</td></tr>
        <tr><td>the same, earlier</td><td>live</td><td>department renamed DAC &rarr; DSAC</td></tr>
        <tr><td><code>NMphetshwa@justice.gov.za</code></td><td>live</td><td>the person had left the section</td></tr>
        <tr><td>SANDF, Visagie Street</td><td>live</td><td>the office had moved to Irene</td></tr>
      </tbody>
    </table></div>
    <p>
      <strong>And here is why a DNS check can never catch the commonest failure.</strong>
      <code>dac.gov.za</code> and <code>dsac.gov.za</code> resolve to <strong>the same mail
      gateway</strong>. The dead department&rsquo;s domain keeps a perfectly valid MX record, the
      shared gateway accepts the mail, and the rejection happens inside, where DNS cannot see it.
    </p>
    <p class="small">
      <strong>The replacement, ordered by what actually catches things:</strong> search the sent mail
      first, for prior contact <em>and</em> prior bounces &mdash; that has caught three failures;
      prefer an address the institution itself gave you over one from a directory; check the
      institution still exists under that name and at that address; then MX, last, to catch a
      mistyped subdomain; then watch for a bounce for a day.
    </p>
  </div>

  {groups.map(([label, list, state, note]) => list.length > 0 && (
    <section>
      <h2>{label}</h2>
      <p class="small muted">{note}</p>
      <Errands groups={[{ rows: toRows(list, state) }]} u={u} />
    </section>
  ))}

  <p class="small muted">
    Intervals: <strong>7 to 10 days</strong> for a private researcher who has been asked for rates;
    <strong>14 days</strong> for a documentation centre or a reading room with a named officer;
    <strong>21 days</strong> for a Master&rsquo;s office, a national archive or a parish;
    <strong>28 days</strong> for an overseas archive in another language.
    <strong>An acknowledgement is not an answer</strong>, and this page keeps the two apart: a row marked
    <em>Acknowledged</em> has been received and queued by a human or a mail robot, nothing more. Its chase
    date does not move. A row that is genuinely answered comes off the chase clock and is kept under
    <em>Answered</em> above, with what it said.
  </p>
</Base>

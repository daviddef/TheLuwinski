---
/* The corrections this archive has made to the family record, one entry each.
 *
 * Written 9 October 2026. They were already public: Method has printed the
 * same twenty rows as a table, under «Corrections to the source», and every
 * other archive in the estate has a /corrections/ page, so a reader who knew the
 * menu from another archive found nothing here under that name. This is the
 * same register (data/corrections.json through register.json), drawn by the
 * kit's Corrections component. Nothing is rewritten: the strings are escaped
 * and printed as the data holds them, markers and all, because «was» is the
 * archive's record of what it used to say. Method now links here instead of
 * carrying a second copy.
 */
import Base from '../layouts/Base.astro';
import Corrections from '@daviddef/archive-kit/components/Corrections.astro';
import register from '../data/register.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p) => (/^https?:/.test(p) ? p : base + p);
const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rows = register.corrections.map((c) => ({
  id: 'c' + c.id,
  who: esc(c.who) + ' <span class="muted">· ' + esc(c.field) + '</span>',
  was: esc(c.was),
  now: esc(c.now),
  how: esc(c.source),
  why: c.why ? esc(c.why) : '',
}));
---
<Base title="Corrections"
  subtitle={`${rows.length} corrections, each carrying what the family record said, what this archive says instead, and the evidence`}
  lede="Where a named source overrides the family record, the correction is applied to the register and listed here with the evidence. Nothing is silently rewritten: the original value is carried through as was, so a reader can always see what the family believed and why this archive disagrees.">
  <Corrections rows={rows} u={u} />
  <p class="small muted" style="margin-top:1.5rem">The same register, as a table, was on <a href={base + '/method/'}>Method</a> until 9 October 2026. <a href={base + '/changes/'}>What changed &rarr;</a> records the corrections as they were made.</p>
</Base>

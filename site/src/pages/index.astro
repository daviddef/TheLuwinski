<script is:inline>
  (function () {
    var box = document.getElementById('tlDetail');
    if (!box) return;
    var hint = document.getElementById('tlHint');
    var who = document.getElementById('tlWho'), ttl = document.getElementById('tlTitle');
    var meta = document.getElementById('tlMeta'), txt = document.getElementById('tlText');
    var current = null;
    function close() {
      box.hidden = true;
      if (hint) hint.hidden = false;
      if (current) current.classList.remove('on');
      current = null;
    }
    document.addEventListener('click', function (e) {
      var b = e.target.closest('.tl-ev');
      if (!b) return;
      if (current) current.classList.remove('on');
      current = b; b.classList.add('on');
      who.textContent = b.dataset.who;
      ttl.textContent = b.dataset.title;
      meta.textContent = b.dataset.kind + ' · ' + b.dataset.y;
      txt.textContent = b.dataset.detail;
      box.hidden = false;
      if (hint) hint.hidden = true;
      box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
    document.getElementById('tlClose').addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>

---
/* Every dated thing in this archive's own record files, in order.
   Seven other archives have had a timeline and this one had none — not for
   want of the component, which is the kit's and is thin, but because there
   was no timeline.json to feed it.

   THIS PAGE IS DERIVED, NOT CURATED, AND THAT IS SAID OUT LOUD BELOW.
   Every event is assembled from a structured record already published here —
   the register, the passenger lists, the Gedenkbuch entries — and none of it
   is written for the timeline. Nothing is chosen: if a record carries a year,
   it is here. Choosing which fixed points matter is this archive's editorial
   work and has been left for it, on the view that a working page is a better
   thing to curate from than a blank one.

   Two rules the assembly follows and will not break:
   - a status a record carries travels with it. Georg Leibholz's Gedenkbuch
     entry is marked DOCUMENTED — but NOT a brother, so he appears with that
     said, and is not quietly folded in as family.
   - a deportation is rendered from the record's own words and nothing is
     added to them. */
import Base from '../layouts/Base.astro';
import Timeline from '@daviddef/archive-kit/components/Timeline.astro';
import register from '../data/register.json';
import emigration from '../data/emigration.json';
import gedenkbuch from '../data/gedenkbuch.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p) => base + p;
const yr = (s) => {
  const m = String(s ?? '').match(/(\d{4})/);
  return m ? Number(m[1]) : null;
};
/* German record dates are DD.MM.YYYY. */
const de = (s) => {
  const m = String(s ?? '').match(/^(\d{2})\.(\d{2})\.(\d{4})$/);
  if (!m) return null;
  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
                  'August', 'September', 'October', 'November', 'December'];
  return { year: Number(m[3]), when: `${Number(m[1])} ${months[Number(m[2]) - 1]} ${m[3]}` };
};

const events = [];

/* 1. The register — a birth and a death are the two dates a person leaves. */
for (const p of register.people || []) {
  const name = p.name || [p.first, p.last].filter(Boolean).join(' ');
  if (!name) continue;
  const b = yr(p.by), d = yr(p.dy);
  /* A TIMELINE PLOTS A POINT, AND A BOUND IS NOT A POINT. "Before 1955" and
     "After May 13 1942" reach us as bare years and would be plotted as though
     the archive knew the date. It has to plot them somewhere, so it plots them
     there AND SAYS WHAT THEY ARE — the qualifier is in the `when` column. */
  if (b) events.push({ year: b, when: p.byq ? `${p.byq} ${b}` : String(b),
                       title: `<strong>${name}</strong> born`,
                       kind: 'Life', source: 'The register' });
  if (d) events.push({ year: d, when: p.dyq ? `${p.dyq} ${d}` : String(d),
                       title: `<strong>${name}</strong> died`,
                       kind: 'Life', source: 'The register' });
}

/* 2. The passenger lists — a departure is a dated act with a ship on it. */
const rowsEm = Array.isArray(emigration) ? emigration
  : Object.values(emigration).find((v) => Array.isArray(v)) || [];
for (const e of rowsEm) {
  const y = yr(e.dep_year);
  if (!y) continue;
  const who = [e.title, e.first, e.last].filter(Boolean).join(' ');
  const when = [e.dep_day, e.dep_month, e.dep_year].every(Boolean)
    ? `${e.dep_day}/${e.dep_month}/${e.dep_year}` : String(y);
  events.push({
    year: y, when,
    title: `<strong>${who}</strong> sailed ${e.dep_port} → ${e.dest_port}, <em>${e.ship}</em>`,
    kind: 'Journey', source: e.piece || 'TNA BT27',
  });
}

/* 3. The Gedenkbuch — the German federal memorial book. Rendered from the
      record's own words, with the status it carries. */
const rowsG = Array.isArray(gedenkbuch) ? gedenkbuch
  : Object.values(gedenkbuch).find((v) => Array.isArray(v)) || [];
for (const g of rowsG) {
  const flag = /NOT a brother/i.test(g.status || '')
    ? ' <em>— documented, and this archive holds that he is not a brother of the others</em>' : '';
  const born = de(g.born);
  if (born) events.push({
    year: born.year, when: born.when,
    title: `<strong>${g.name}</strong> born at ${g.birthplace}${flag}`,
    kind: 'Life', source: `Gedenkbuch ${g.gedenkbuch_id}`,
  });
  for (const dep of [g.deportation_1, g.deportation_2]) {
    if (!dep) continue;
    const m = String(dep).match(/(\d{2}\.\d{2}\.\d{4})/);
    const when = m ? de(m[1]) : null;
    const y = when ? when.year : null;
    if (!y) continue;
    events.push({
      year: y, when: when.when,
      title: `<strong>${g.name}</strong> deported — ${dep.replace(/^from /, 'from ')}`,
      kind: 'Deportation', source: `Gedenkbuch ${g.gedenkbuch_id}`,
    });
  }
  const died = de(g.death_date);
  if (died) events.push({
    year: died.year, when: died.when,
    title: `<strong>${g.name}</strong> died at ${g.death_place}`,
    kind: 'Deportation', source: `Gedenkbuch ${g.gedenkbuch_id}`,
  });
}

events.sort((a, b) => a.year - b.year);
const span = events.length ? [events[0].year, events[events.length - 1].year] : [null, null];
const deportations = events.filter((e) => e.kind === 'Deportation').length;
---
<Base
  title="The Timeline"
  subtitle={`${span[0]}–${span[1]} · ${events.length} dated events`}
  lede="Every dated thing in this archive's own record files, in order: births and deaths from the register, departures from the passenger lists, and the Gedenkbuch entries with the dates they carry.">

  <div class="note">
    <p><strong>This page is derived, not chosen.</strong> Every event on it is assembled from a
      structured record already published here, and nothing has been written for the timeline.
      If a record carries a year, it is on the page. Deciding which of these are the
      <em>fixed points</em> of this family — and writing the sentences that say why — is work
      this archive has not done yet, and a page it can cut down is easier than a page it must
      start.</p>
  </div>

  <Timeline events={events} u={u} noun="dated events" />

  {deportations > 0 && (
    <div class="note" style="margin-top:22px">
      <p><strong>On the Gedenkbuch entries.</strong> {deportations} of these events are
        deportations and deaths recorded in the German federal memorial book, rendered from the
        record's own words with nothing added. One of the four people named there,
        <strong>Georg Leibholz</strong>, is documented in the Gedenkbuch and is held by this
        archive <em>not</em> to be a brother of the others; he is shown with that said rather
        than left off or quietly counted in.</p>
      <p>This archive has given two reasons for that, and only one of them has weakened.
        The reason usually written down is <em>birthplace</em>: Georg was born at
        <strong>Hammerstein</strong> in West Prussia and Jacob, Samuel and Oskar at
        <strong>Schubin</strong> in Posen. <strong>That reason has largely gone.</strong> On
        20 September 2026 this archive established that <strong>Sally Leibholz</strong>, the
        father of the three, was himself born at Hammerstein, and that the memorial book's
        fifty cluster on Kreis Schlochau rather than on Posen — so Hammerstein is the home and
        Schubin is the move, and a Hammerstein birth no longer puts a man outside this family.</p>
      <p><strong>The second reason stands, and it is the stronger one.</strong> Georg was born
        on <strong>7 June 1884</strong> and Jacob on <strong>8 August 1884</strong>, two months
        apart. Two men born two months apart are not brothers, and the point survives the
        one-year discrepancy in Georg's record — a second source gives 7 June 1885, which
        leaves ten months and the same conclusion. <strong>Georg is kept out of this family on
        arithmetic, not on absence of proof.</strong> What the Hammerstein finding changed is
        that he is almost certainly kin of some other degree: a second, West Prussian Leibholz
        line, which is where Hans Israel Leibholz of Preußisch Friedland and Irmgard Shtern,
        who calls herself Georg's niece, belong.</p>
    </div>
  )}
</Base>

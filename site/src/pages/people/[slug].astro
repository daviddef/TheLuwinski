---
/* /people/<slug>/ - ONE PAGE FOR EVERY PERSON THIS ARCHIVE NAMES. Two kinds share the route.

   1. THE ENGLISH LINE (added 13 October 2026): twenty direct ancestors on the Wear and Hawkins
      sides, hand-written in data/english-people.json, each with a grade and what is not known.
   2. THE REGISTER (added 16 October 2026): everybody in site/src/data/register.json - the family
      proper, the surname index, the people found in a register, the placeholders and the living -
      drawn from the register and from nothing else. The living standard (version 2) decides what a
      LIVING person's page may say: their name, their relationships, their town and country, and
      nothing more. Their page is `noindex`, carries no structured data, no table, no image and no
      year, and so is left out of the sitemap and the search index by construction. Derrick, the
      subject of the archive, is the exception that goes the other way: named with his parents and
      nothing else, not even a town. tools/check-living.py reads the built pages and fails on any of
      this, and its self-test plants each fault to prove that it does.

   WHY THESE ROUTES CARRY KIT COMPONENTS. `people/[slug]` and `people/index` are page names six sibling
   archives already have, and checkpages counts a shared page name as bespoke if the page uses NO kit
   component at all - this archive's cap is one, set deliberately. PersonTree and Evidence are not
   there to satisfy that: a person page genuinely wants its relatives drawn as linked nodes and its
   grade drawn on the shared five-word ladder.

   THE ENGLISH DATA IS HAND-WRITTEN AND SAYS WHAT IT DOES NOT KNOW. Every record has a `gaps` list, and a
   relationship carries how it is known (read in a record, a best candidate, or a tree's word) as a
   class on its node AND as a word under the name, because colour is no use to a reader who cannot
   see it. Nobody there was born after 1895. */
import Base from '../../layouts/Base.astro';
import PersonTree from '@daviddef/archive-kit/components/PersonTree.astro';
import Evidence from '@daviddef/archive-kit/components/Evidence.astro';
import { md } from '@daviddef/archive-kit/lib/md.js';
import '@daviddef/archive-kit/styles/persontree.css';
import data from '../../data/english-people.json';
import register from '../../data/register.json';
import evidence from '../../data/evidence.json';
import { familyOf, isoDate } from '../../lib/kin.js';

export function getStaticPaths() {
  return [
    ...data.people.map((p) => ({ params: { slug: p.slug }, props: { p, reg: null } })),
    ...register.people.map((r) => ({ params: { slug: r.slug }, props: { p: null, reg: r } })),
  ];
}
const { p, reg } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const VIA = { read: 'via-read', inferred: 'via-inferred', tree: 'via-tree' };
/* A record that was read needs no word under the name; the other two do. */
const WORD = { inferred: 'best candidate', tree: 'from a tree' };

/* ---------------------------------------------------------------------------------------------
   1. THE ENGLISH LINE
   --------------------------------------------------------------------------------------------- */
function englishView(p) {
  const node = (k, small) => ({
    name: k.n,
    href: k.href ? base + k.href : k.s ? `${base}/people/${k.s}/` : undefined,
    dates: k.dates || '',
    cls: VIA[k.via] || 'via-none',
    mark: k.mark || WORD[k.via],
    mar: k.mar,
    small,
  });
  const kin = p.kin;
  /* THE KIT'S SIBLING ROW NEVER READS `mark`: it emits a name and the dates and nothing else, so a
     sibling's «half-brother» or «best candidate» would be dropped without a word and left to colour
     alone, which is exactly what the component's own docs say is no use to a reader who cannot
     see it. Found 13 October 2026 by checking the rendered text rather than the data. For siblings only,
     the wording goes on the dates line, which the row does print. */
  const siblings = kin.siblings.map((k) => {
    const n = node(k, true);
    n.dates = [n.dates, n.mark].filter(Boolean).join(' \u00b7 ');
    return n;
  });
  const children = kin.children.map((k) => node(k, kin.children.length > 5));
  const lifeLine = [p.born && p.born !== 'not established' ? `Born ${p.born}` : '',
                    p.died && p.died !== 'not established' ? `died ${p.died}` : ''].filter(Boolean).join(' \u00b7 ');
  return { node, kin, siblings, children, lifeLine };
}
const E = p ? englishView(p) : null;
const TAG = { doc: 'Documented', inf: 'Read with care', disp: 'Corrected' };

/* ---------------------------------------------------------------------------------------------
   2. THE REGISTER
   --------------------------------------------------------------------------------------------- */
const KIND = {
  family: 'In the family tree this archive was built from',
  index: 'Listed in the register\u2019s surname index',
  document: 'Found in a register, in nobody\u2019s tree',
};
const qy = (y, q) => (y ? (q ? `${q} ${y}` : String(y)) : '');
function registerView(r) {
  const living = r.living === true;
  const bare = r.bare === true;
  /* A page that may say a name, relationships, and a town and country, and nothing else. */
  const bareOnly = living || bare;
  const fam = familyOf(r.id, { livingSelf: bareOnly, datesOff: bareOnly });
  /* Every link on this chart is the family tree's word. Colour is no use to a reader who cannot see
     it, so the word goes under the name too; a sibling row never prints `mark`, so for siblings it
     goes on the dates line, as on the English pages. */
  const tag = (n, sib) => {
    const o = { ...n, cls: 'via-tree', small: sib || n.small };
    if (sib) o.dates = [n.dates, n.mark].filter(Boolean).join(' \u00b7 ');
    return o;
  };
  const chart = {
    self: fam.self,
    parents: fam.parents.map((n) => tag(n)),
    spouses: fam.spouses.map((n) => tag(n)),
    children: fam.children.map((n) => tag(n)),
    siblings: fam.siblings.map((n) => tag(n, true)),
  };
  const b = qy(r.by, r.byq), dd = qy(r.dy, r.dyq);
  const years = b && dd ? `${b} \u2013 ${dd}` : b ? `b. ${b}` : dd ? `d. ${dd}` : '';
  const span = years || 'no dates recorded';
  const lifeLine = [r.born ? `Born ${r.born}` : '', r.died ? `died ${r.died}` : ''].filter(Boolean).join(' \u00b7 ');
  const kindLine = r.placeholder
    ? 'A placeholder: the source tree holds this record for someone it could not name.'
    : KIND[r.kind] + '.';
  const read = [];
  for (const e of evidence.people.filter((x) => x.register_id === r.id))
    for (const rec of e.records) if (!read.some((q) => q.title === rec.title)) read.push(rec);
  const about = (bareOnly || r.placeholder) ? undefined : {   // no Person for the living, or for a placeholder that stands for nobody
    name: r.name,
    birthDate: r.byq ? undefined : isoDate(r.born),
    deathDate: r.dyq ? undefined : isoDate(r.died),
  };
  const facts = (r.facts || []).map((f) => ({
    what: String(f.t || '').replace(/:$/, ''), when: f.date || '', where: f.place || '',
    note: [f.c, f.ac].filter(Boolean).join(' \u2014 '),
  }));
  return { living, bare, bareOnly, chart, span, lifeLine, kindLine, read, about, facts, nfam: fam.parents.length + fam.spouses.length + fam.children.length + fam.siblings.length };
}
const R = reg ? registerView(reg) : null;
---
{E && (
<Base title={p.name} subtitle={p.dates + ' · ' + p.rel} lede={p.dek}>

  <div class="panel">
    <p>
      <Evidence level={p.grade} />
      <span class="small muted">{p.why}</span>
    </p>
    {E.lifeLine && <p class="small" style="margin:.2rem 0 0 0;"><strong>{E.lifeLine}</strong></p>}
  </div>

  <section class="blk">
    <h2>Family</h2>
    <PersonTree always
      self={{ name: p.name, dates: p.dates, gen: p.rel }}
      parents={E.kin.parents.map((k) => E.node(k))}
      spouses={E.kin.spouses.map((k) => E.node(k))}
      children={E.children}
      siblings={E.siblings}
      keys={[{ cls: 'via-read', label: 'read in a record' },
             { cls: 'via-inferred', label: 'a best candidate, not proved' },
             { cls: 'via-tree', label: 'a family tree’s word' }]}>
    </PersonTree>
  </section>

  <h2>What is known</h2>
  <div class="scroll"><table>
    <thead><tr><th>When</th><th>What</th><th></th><th>Status</th></tr></thead>
    <tbody>
      {p.facts.map(([when, what, detail, g]) => (
        <tr>
          <td>{when}</td>
          <td><strong>{what}</strong></td>
          <td>{detail}</td>
          <td><span class={'tag ' + g}>{TAG[g]}</span></td>
        </tr>
      ))}
    </tbody>
  </table></div>

  <div class="panel" id="gaps">
    <h3>What is not established</h3>
    <ul class="small">
      {p.gaps.map((g) => <li>{g}</li>)}
    </ul>
  </div>

  <p class="small muted">
    {p.see.map(([label, href], i) => (
      <Fragment>{i > 0 && ' · '}<a href={base + href}>{label}</a></Fragment>
    ))}
    {' · '}<a href={base + '/people/'}>All the people</a>
  </p>
</Base>
)}

{R && R.bareOnly && (
<Base title={reg.name} noindex structured={false}
  subtitle={R.bare ? 'Living. Named with his parents, and nothing more.' : 'Living. Named, with relationships and place, and nothing more.'}
  lede={R.bare ? 'This archive is organised around him and says almost nothing about him. That is deliberate.' : undefined}>

  <div class="panel">
    {R.bare ? (
      <p><strong>Living.</strong> Named with his parents, and nothing more: no town, no date, no record, no
        photograph. <a href={base + '/derrick/'}>Why this archive is built around him and says so little</a>.</p>
    ) : (
      <p><strong>Living.</strong> A living person (80 or younger, with no death recorded) is named with their
        relationships and their town and country, and nothing more.</p>
    )}
    {reg.place && (
      <dl class="kv">
        <dt>Town and country</dt><dd>{reg.place}</dd>
      </dl>
    )}
  </div>

  <section class="blk" id="family">
    <h2>Family</h2>
    <PersonTree always self={R.chart.self} parents={R.chart.parents} spouses={R.chart.spouses}
      children={R.chart.children} siblings={R.chart.siblings}
      labels={R.bare ? { parents: 'His parents' } : {}}
      keys={[{ cls: 'via-tree', label: 'a family tree’s word, not checked here' }]}>
    </PersonTree>
  </section>

  <p class="small muted">
    <a href={base + '/people/'}>&larr; All the people</a> &middot;
    <a href={base + '/register/'}>The register</a> &middot;
    <a href={base + '/bloodline/?p=' + reg.id}>Blood relatives</a>
  </p>
</Base>
)}

{R && !R.bareOnly && (
<Base title={reg.name} subtitle={R.span + ' · ' + R.kindLine} about={R.about}>

  <div class="panel">
    <p>
      {reg.kind === 'family' && <span class="tag inf">Family tree</span>}
      {reg.kind === 'index' && <span class="tag open">Surname index</span>}
      {reg.kind === 'document' && <span class="tag disp">Unproven kinship</span>}
      {reg.placeholder && <>{' '}<span class="tag open">Placeholder</span></>}
    </p>
    {R.lifeLine && <p class="small"><strong>{R.lifeLine}</strong></p>}
    {reg.no_death_recorded && (
      <p class="small muted">The source tree records no death for this person. {reg.by
        ? 'They were born more than eighty years ago, so this archive does not treat them as living.'
        : 'No birth year is recorded, so there is nothing to show them to be eighty or younger, and this archive does not treat them as living.'}</p>
    )}
  </div>

  <section class="blk" id="family">
    <h2>Family</h2>
    <PersonTree always self={R.chart.self} parents={R.chart.parents} spouses={R.chart.spouses}
      children={R.chart.children} siblings={R.chart.siblings}
      keys={R.nfam ? [{ cls: 'via-tree', label: 'a family tree’s word; nothing here has been read to confirm it' }] : []}>
    </PersonTree>
    {R.nfam === 0 && (
      <p class="small muted">The source records no relatives for {reg.name}.</p>
    )}
  </section>

  <section class="blk" id="record">
    <h2>What the record says</h2>
    {R.facts.length > 0 ? (
      <div class="scroll"><table>
        <thead><tr><th>What</th><th>When</th><th>Where</th><th>Noted</th></tr></thead>
        <tbody>
          {R.facts.map((f) => (
            <tr><td><strong>{f.what}</strong></td><td>{f.when}</td><td>{f.where}</td><td class="small muted">{f.note}</td></tr>
          ))}
        </tbody>
      </table></div>
    ) : (
      <p>Nothing is recorded about {reg.name} beyond the name{R.nfam ? ' and the relatives above' : ''}. {reg.placeholder
        ? 'This is a placeholder, not a person.'
        : 'Known only from the household that names them; nothing else is recorded yet.'}</p>
    )}
    {reg.corrections && reg.corrections.map((c) => (
      <div class="panel">
        <h3>Corrected <span class="tag disp">{c.field}</span></h3>
        <p class="small"><strong>The family record said:</strong> {c.was}<br /><strong>This archive now has:</strong> {c.now}</p>
        <p class="small muted">{c.source}</p>
      </div>
    ))}
  </section>

  <section class="blk" id="sources">
    <h2>Where this comes from</h2>
    {reg.kind === 'document' ? (
      <div class="small" set:html={md(reg.basis)}></div>
    ) : (
      <p>The tree this register is built from: one MyHeritage harvest, which is somebody else&rsquo;s research and has
        not been checked here beyond what is said below.</p>
    )}
    {R.read.length > 0 ? (
      <Fragment>
        <p class="small"><strong>Read here, about this person:</strong></p>
        <ul class="small">
          {R.read.map((rec) => <li>{rec.title} <span class="muted">&mdash; {rec.source}</span></li>)}
        </ul>
      </Fragment>
    ) : (
      <p class="small muted">No record has been read about this person in this archive.</p>
    )}
    <p class="small muted"><a href={base + '/method/'}>How the register is built, and what its labels mean</a>.</p>
  </section>

  <p class="small muted">
    <a href={base + '/people/'}>&larr; All the people</a> &middot;
    <a href={base + '/register/'}>The register</a> &middot;
    <a href={base + '/bloodline/?p=' + reg.id}>Blood relatives</a>
  </p>
</Base>
)}

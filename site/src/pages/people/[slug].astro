---
/* /people/<slug>/ - ONE PAGE FOR EVERY PERSON THIS ARCHIVE NAMES, DRAWN BY THE KIT'S SHARED PEOPLE PAGE
   (PERSON-PAGE-SPEC.md). Pilot, 17 October 2026: this is the first archive to adopt it.

   Two kinds of person share the route, and both go through the kit's PersonPage:

   1. THE ENGLISH LINE (13 October 2026): twenty direct ancestors on the Wear and Hawkins sides,
      hand-written in data/english-people.json, each with a grade and what is not known.
   2. THE REGISTER (16 October 2026): everybody in site/src/data/register.json - the family proper, the
      surname index, the people found in a register, the placeholders and the living.

   WHAT THE KIT DECIDES NOW, and this page no longer does: the order and the words of the headings
   (Family, What the record says, Where this comes from, then Notes and corrections), the chart's source
   words, how a date is written, what a living relative looks like, and what a living person's page may
   hold. THE LIVING STANDARD (version 2) is the kit's: a living person is named with their relationships
   and their town and country and nothing more; their page is `noindex`, has no structured data, no
   table, no image, no year, and the kit's PersonPage does not render a record, a source or a note for
   them at all. tools/check-living.py reads the built pages and still fails on any of it.

   THE ONE EXCEPTION, kept as it was: Derrick, the subject of the archive, is named with his parents and
   nothing else, not even a town. The mechanism is the register's own `bare` flag (tools/people_decisions.py
   NAMED_BARE), read here as `reg.bare`, and it is not generalised: the kit draws him as it draws any living
   person, and his note ("why this archive is built around him and says so little") stands beside the
   page, outside the kit's article, exactly as it said it before.

   WHO IS LIVING is computed, not set. See src/lib/people.js for how the generator's answer (the kit's
   rule, run in tools/build-register.py with the private harvest) reaches the kit's JavaScript twin and what
   stops a disagreement from being drawn.

   WHAT THE KIT'S CHART CANNOT SAY, said under it instead of dropped: an English-line edge's own wording
   («banns read», «probably the other couple's», «half-brother») and a register half-sibling go in the
   chart's note. The kit chart draws the source word only.

   WHY THESE ROUTES CARRY KIT COMPONENTS. `people/[slug]` and `people/index` are page names six sibling
   archives also have, and checkpages counts a shared page name as bespoke if the page uses NO kit
   component at all - this archive's cap is one, set deliberately. */
import Base from '../../layouts/Base.astro';
import PersonPage from '@daviddef/archive-kit/components/PersonPage.astro';
import PersonSection from '@daviddef/archive-kit/components/PersonSection.astro';
import EvidenceChip from '@daviddef/archive-kit/components/EvidenceChip.astro';
import PS from '@daviddef/archive-kit/data/public-sources.json';
import { personMeta } from '@daviddef/archive-kit/lib/person.js';
import { md } from '@daviddef/archive-kit/lib/md.js';
import '@daviddef/archive-kit/styles/persontree.css';
import '@daviddef/archive-kit/styles/personpage.css';
import data from '../../data/english-people.json';
import register from '../../data/register.json';
import { isoDate } from '../../lib/kin.js';
import { registerPerson, englishPerson, agreeWithGenerator, lineNotes, halfSiblings, isLivingRecord } from '../../lib/people.js';
import EraNote from '@daviddef/archive-kit/components/EraNote.astro';
import { eraAt, plainYear } from '@daviddef/archive-kit/lib/era.js';
import eraSnapshot from '../../data/era-snapshot.json';
import { lifePlace, dayFirst, yearOf } from '../../lib/eraplace.js';

export function getStaticPaths() {
  return [
    ...data.people.map((p) => ({ params: { slug: p.slug }, props: { p, reg: null } })),
    ...register.people.map((r) => ({ params: { slug: r.slug }, props: { p: null, reg: r } })),
  ];
}
const { p, reg } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const TAG = { doc: 'Documented', inf: 'Read with care', disp: 'Corrected' };
const KIND = {
  family: 'In the family tree this archive was built from',
  index: 'Listed in the register’s surname index',
  document: 'Found in a register, in nobody’s tree',
};

/* ---------------------------------------------------------------------------------------------
   Everything the page needs, decided once: the kit's person object, the head's title and description,
   the lines of prose each section carries.
   --------------------------------------------------------------------------------------------- */
let person, meta, view;
if (p) {
  person = englishPerson(p);
  meta = personMeta(person, { siteName: '', sources: PS });
  const lifeLine = [p.born && p.born !== 'not established' ? `Born ${p.born}` : '',
                    p.died && p.died !== 'not established' ? `died ${p.died}` : ''].filter(Boolean).join(' · ');
  view = { english: true, lifeLine, notes: lineNotes(person) };
} else {
  const made = registerPerson(reg);
  person = made.person;
  agreeWithGenerator(reg, person);
  const living = isLivingRecord(reg);
  const kindLine = reg.placeholder
    ? 'A placeholder: the source tree holds this record for someone it could not name.'
    : KIND[reg.kind] + '.';
  if (!living) person.lede = kindLine;
  meta = personMeta(person, { siteName: '', sources: PS });
  /* The register's own date strings, kept in the record section wherever the header could not print one
     (a place after the date, a bound such as «Before 1955», a death that is a deportation). */
  const lifeLine = [reg.born ? `Born ${reg.born}` : '', reg.died ? `died ${reg.died}` : ''].filter(Boolean).join(' · ');
  const lossy = (reg.born && !person.born) || (reg.died && !person.died) || /[,?]/.test(`${reg.born}${reg.died}`);
  const facts = (reg.facts || []).map((f) => ({
    what: String(f.t || '').replace(/:$/, ''), when: f.date || '', where: f.place || '',
    note: [f.c, f.ac].filter(Boolean).join(' — '),
  }));
  view = {
    english: false, living, bare: reg.bare === true, placeholder: reg.placeholder === true,
    kindLine, lifeLine: lossy ? lifeLine : '', facts, read: made.read, nfam: made.person.relations.parents.length
      + made.person.relations.spouses.length + made.person.relations.children.length + made.person.relations.siblings.length,
    half: halfSiblings(person),
  };
}
/* The subject keeps the sentence he always had for the description; every other living person gets the
   standard's one fixed sentence from personMeta. */
/* AN «AT THE TIME» NOTE beside a dated place (kit/docs/era-notes.md; David, 18 October 2026): who held that ground in that year, from the
   Record Atlas's REGION eras, as this archive committed them (src/data/era-snapshot.json, rebuilt deliberately by tools/build-era.py
   --snapshot; the place -> region table is data/era/ground.tsv). Context about the ground, never a claim about the family.
   NEVER ON A LIVING, NAMED-ONLY OR NOINDEX PAGE: `noNotes` is the page's own decision (the register's living / bare flag, and the kit's noindex),
   no fact is drawn for such a person at all, and the build gate check:era fails any note found on a noindex page, a data-living page or a page
   in the register's living list. Two kinds of page print a dated place:
     - a register person's facts table (date in «When», place in «Where»): the note sits under the place;
     - the English line's born / died line, but ONLY where it is «<plain date>, <one place>» (src/lib/eraplace.js); the line's longer prose
       («Q1 1890, St Olave Southwark, aged 31») is not read, and gets no note.
   The year is read off the date the page prints (the tree writes «Nov 12 1807»; dayFirst puts it in the kit's form), and plainYear refuses it
   unless the whole date is a plain one («23 Jan 1865», «Jul 1972», «1802»): «Circa 1860», «Between ...», «June 28 1877?» give no note. eraAt
   gives none for a year on an era's edge (it words that one «From that year»), an unassessed era unless the snapshot's policy allows it, a
   place with no region or too near its ring's edge, an era the Atlas labels as shorthand, or a modern year in the era still running. */
const noNotes = !!(reg && view.living) || !!meta.noindex;
const eraOn = (place, date) => {
  if (noNotes || !place || !date) return null;
  const d = dayFirst(date);
  return eraAt(eraSnapshot, place, plainYear(d, yearOf(d)));
};
if (reg) view.facts = view.facts.map((f) => ({ ...f, era: eraOn(f.where, f.when) }));
const lifeEra = (text) => { const lp = p ? lifePlace(text) : null; return lp ? eraOn(lp.place, lp.date) : null; };
const bornEra = p ? lifeEra(p.born) : null;
const diedEra = p ? lifeEra(p.died) : null;
const description = view.bare ? 'Living. Named with his parents, and nothing more.' : meta.description;
const peopleHref = base + '/people/';
const stubNote = 'the household that names them';
const chartLabels = view.bare ? { parents: 'His parents' } : {};
const about = !p && view.placeholder ? undefined : (meta.about ?? undefined);   // no Person for a placeholder: it stands for nobody
---
<Base title={meta.title} subtitle={description} noindex={meta.noindex} structured={!meta.living} about={about} ownHeading noAutolink>

  {p && (
  <PersonPage person={person} peopleHref={peopleHref} stubNote={stubNote}>
    <Fragment slot="chart-notes">
      {view.notes.length > 0 && (
        <Fragment>
          <p class="small">On the individual lines:</p>
          <ul class="small">
            {view.notes.map((n) => <li><strong>{n.name}</strong> ({n.label}): {n.text}</li>)}
          </ul>
        </Fragment>
      )}
    </Fragment>

    <Fragment slot="record">
      <p>
        <EvidenceChip level={p.grade} />
        <span class="small muted">{p.why}</span>
      </p>
      {view.lifeLine && (bornEra || diedEra) ? (
        <div class="small" style="margin:1em 0">
          {p.born && p.born !== 'not established' ? <p style="margin:0"><strong>{`Born ${p.born}`}</strong><EraNote era={bornEra} /></p> : null}
          {p.died && p.died !== 'not established' ? <p style="margin:.2rem 0 0"><strong>{`Died ${p.died}`}</strong><EraNote era={diedEra} /></p> : null}
        </div>
      ) : view.lifeLine && <p class="small"><strong>{view.lifeLine}</strong></p>}
      <div class="scroll"><table>
        <thead><tr><th>When</th><th>What</th><th></th><th>Status</th></tr></thead>
        <tbody>
          {p.facts.map(([when, what, detail, g]) => (
            <tr>
              <td>{when}</td>
              <td><strong>{what}</strong></td>
              <td>{detail}</td>
              <td><span class={'tag ' + g}>{TAG[g]}</span></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </Fragment>

    <Fragment slot="sources">
      <p class="small">Each line of the table above names the record it rests on in its third column, and
        the grade at the top says how well the whole is evidenced. What is not established is said under
        its own heading below. <a href={base + '/method/'}>How the grades and the labels on the chart are
        decided</a>, and <a href={base + '/sources/'}>every source this archive holds</a>.</p>
      <p class="small muted">
        {p.see.map(([label, href], i) => (
          <Fragment>{i > 0 && ' · '}<a href={base + href}>{label}</a></Fragment>
        ))}
      </p>
    </Fragment>

    <PersonSection kind="more" title="What is not established">
      <div class="panel" id="gaps">
        <ul class="small">
          {p.gaps.map((g) => <li>{g}</li>)}
        </ul>
      </div>
    </PersonSection>
  </PersonPage>
  )}

  {reg && view.living && (
  <PersonPage person={person} peopleHref={peopleHref} labels={chartLabels} />
  )}

  {reg && view.bare && (
  <aside class="panel" id="subject" aria-label="Why this page says so little">
    <p>This archive is organised around him and says almost nothing about him. That is deliberate.</p>
    <p><strong>Living.</strong> Named with his parents, and nothing more: no town, no date, no record, no
      photograph. <a href={base + '/derrick/'}>Why this archive is built around him and says so little</a>.</p>
  </aside>
  )}

  {reg && !view.living && (
  <PersonPage person={person} peopleHref={peopleHref} stubNote={stubNote}>
    <Fragment slot="chart-notes">
      {view.half.length > 0 && (
        <p class="small">{view.half.join(' and ')} {view.half.length > 1 ? 'are half-siblings' : 'is a half-sibling'}.</p>
      )}
    </Fragment>

    <Fragment slot="record">
      {view.lifeLine && <p class="small"><strong>{view.lifeLine}</strong></p>}
      {reg.no_death_recorded && (
        <p class="small muted">The source tree records no death for this person. {reg.by
          ? 'They were born more than eighty years ago, so this archive does not treat them as living.'
          : 'No birth year is recorded, so there is nothing to show them to be eighty or younger, and this archive does not treat them as living.'}</p>
      )}
      {view.facts.length > 0 ? (
        <div class="scroll"><table>
          <thead><tr><th>What</th><th>When</th><th>Where</th><th>Noted</th></tr></thead>
          <tbody>
            {view.facts.map((f) => (
              <tr><td><strong>{f.what}</strong></td><td>{f.when}</td><td>{f.where}<EraNote era={f.era} /></td><td class="small muted">{f.note}</td></tr>
            ))}
          </tbody>
        </table></div>
      ) : (
        <p class="pnone">Nothing is recorded about {reg.name} beyond the name{view.nfam ? ' and the relatives above' : ''}. {view.placeholder
          ? 'This is a placeholder, not a person.'
          : 'Known only from the household that names them; nothing else is recorded yet.'}</p>
      )}
    </Fragment>

    <Fragment slot="sources">
      <p>
        {reg.kind === 'family' && <span class="tag inf">Family tree</span>}
        {reg.kind === 'index' && <span class="tag open">Surname index</span>}
        {reg.kind === 'document' && <span class="tag disp">Unproven kinship</span>}
        {view.placeholder && <>{' '}<span class="tag open">Placeholder</span></>}
      </p>
      {reg.kind === 'document' ? (
        <div class="small" set:html={md(reg.basis)}></div>
      ) : (
        <p>The tree this register is built from: one MyHeritage harvest, which is somebody else&rsquo;s research and has
          not been checked here beyond what is said below.</p>
      )}
      {view.read.length > 0 ? (
        <Fragment>
          <p class="small"><strong>Read here, about this person:</strong></p>
          <ul class="small">
            {view.read.map((rec) => <li>{rec.title} <span class="muted">&mdash; {rec.source}</span></li>)}
          </ul>
        </Fragment>
      ) : (
        <p class="small muted">No record has been read about this person in this archive.</p>
      )}
      <p class="small muted"><a href={base + '/method/'}>How the register is built, and what its labels mean</a>.</p>
    </Fragment>

    {reg.corrections && reg.corrections.length > 0 && (
    <PersonSection kind="notes">
      {reg.corrections.map((c) => (
        <div class="panel">
          <h3>Corrected <span class="tag disp">{c.field}</span></h3>
          <p class="small"><strong>The family record said:</strong> {c.was}<br /><strong>This archive now has:</strong> {c.now}</p>
          <p class="small muted">{c.source}</p>
        </div>
      ))}
    </PersonSection>
    )}
  </PersonPage>
  )}

  {reg && (
  <p class="small muted">
    <a href={base + '/register/'}>The register</a> &middot;
    <a href={base + '/bloodline/?p=' + reg.id}>Blood relatives</a>
  </p>
  )}
</Base>

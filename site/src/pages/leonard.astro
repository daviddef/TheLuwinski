---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fs = (a) => `https://www.familysearch.org/ark:/61903/${a}`;
const life = [
  ['Q1 1917', 'Born, and registered at Hitchin', 'Hertfordshire. The GRO birth index, searched on the mother’s maiden name CASTLE, gives Henry Robert Wear and Martha Maud Castle six children at Hitchin between 1917 and 1936. He is the first.', 'doc'],
  ['1921', 'Aged four, at 72 Pix Road, Letchworth', 'The 1921 census. His father is a Bermondsey man; his mother was born at Baldock.', 'doc'],
  ['before 29 Sep 1939', 'The household leaves England', 'Absent from the 1939 Register, and the absence is real rather than redaction — born 1889, his father would be 137. Nationally Henry Robert Wear runs 1891, 1901, 1911, 1921 and then stops.', 'doc'],
  ['7 Sep 1940', 'In the army, at Roberts Heights', 'His own marriage register gives his occupation as ARMY and his residence as ROBERTS HEIGHTS, PRETORIA — the Union Defence Force’s principal base, one year and one day after South Africa entered the war. The first occupation recorded for him anywhere.', 'doc'],
  ['7 Sep 1940', 'Marries Phyllis Agnes Robertson', 'Rosebank, Johannesburg, certificate 13. He is 23, born England, a BACHELOR. Married BY BANNS, without antenuptial contract, by W. P. Whelan, who wrote “Catholic Priest” on the denomination line himself.', 'doc'],
  ['1941', 'His daughter Gillian is born', 'Gillian Agnes Louisa Wear, carrying her mother’s name. She built, in 2018, the seven-person tree that is the only source anywhere giving Leonard a mother called Castle.', 'doc'],
  ['1948', 'The year everything converges', 'He is thirty-one and in Johannesburg, married to somebody else. The DNA says Derrick’s biological father was a son of Henry Robert Wear and Martha Maud Castle. There were two sons. The other was eleven.', 'inf'],
  ['1951', 'Divorced by Phyllis', 'TAB WLD 2026/1951. Six years later he is back in court against her — WLD 790/1957, by then Wear versus Phyllis Agnes NORQUOY, she having remarried in 1952. Opposed applications of that kind are usually about a child.', 'doc'],
  ['30 Oct 1951', 'An engineer, in Berea, married again', 'Johannesburg, certificate 1397. He is 34, born England, a DIVORCEE, and an ENGINEER, of Polana Court, Abel Road, BEREA. Marjorie Eileen Dunlop, born Walker, 34, England, divorcee, school mistress. Special licence 205044, WITH an antenuptial contract. “Order filed” against both names.', 'doc'],
  ['1962', 'Divorced again', 'TAB WLD 2960/1962 — Marjorie Eileen Wear (formerly Dunlop, born Walker) versus Leonard Aubrey Robert.', 'doc'],
  ['1973 or 1979', 'Dies — and the archive still cannot say which, but the two are no longer equal', 'The family tree says 1973. GenDatabase’s death index says 1979 on a record it marks INCOMPLETE, printing his date of birth as the corrupt string 0017. Neither is a document. No estate file, no gazette notice, no grave. NEW: the National Archives deceased-estate index runs to the end of 1976 — so 1973 is inside it and he is not there, while 1979 is three years past its last year and cannot be tested at all.', 'disp'],
];
const where = [
  ['1917', 'Hitchin, Hertfordshire', 'Birth registered', 'doc'],
  ['1921', '72 Pix Road, Letchworth', 'The census. He is four.', 'doc'],
  ['1922–1938', '—', 'Nothing. The family is presumably still at Letchworth: his siblings go on being registered there until 1936.', 'gap'],
  ['by Sep 1939', 'left England', 'Absent from the 1939 Register, and the absence is real rather than redaction.', 'doc'],
  ['7 Sep 1940', 'ROBERTS HEIGHTS, PRETORIA', 'His marriage register. Occupation: Army.', 'doc'],
  ['1941', 'Johannesburg', 'His daughter Gillian is born. No address recorded.', 'inf'],
  ['1942–1950', '—', 'NOTHING AT ALL. Nine years, and 1948 is inside them.', 'gap'],
  ['1951', 'Johannesburg', 'Divorced by Phyllis, WLD 2026/1951. No address on the index entry.', 'doc'],
  ['30 Oct 1951', 'POLANA COURT, ABEL ROAD, BEREA', 'His second marriage register.', 'doc'],
  ['1952', '64 Greenfield Road, Greenside', 'Not his — his sister Cynthia gives it, aged 21 and unmarried. Read as their parents’ house; that was always an inference, and it is now bracketed by two documented parental addresses in Parkhurst.', 'inf'],
  ['1957', 'Johannesburg', 'WLD 790/1957, against his remarried first wife. No address.', 'doc'],
  ['1960', 'Johannesburg', 'WLD 978/1960 — an illiquid case for PAYMENT, Mawthane Dabeah Kwele versus L. A. R. Wear. Somebody sued him for money. A year the archive did not have at all until the National Archives index was driven directly.', 'doc'],
  ['1962', 'Johannesburg', 'WLD 2960/1962, divorced by Marjorie — and WLD 2961/1962, filed one number later, is the same plaintiff suing another woman for damages. No address.', 'doc'],
  ['13 Sep 1969', '271 WILSON STREET, FAIRLANDS', 'He buys his father\u2019s grave. West Park Cemetery Private Graves Register, folio W 8: purchaser WEAR, Mr L. A. R., of 271 Wilson St, Fairlands; receipt 11484; \u00a360; grave 56045, section E.C.; person buried Henry Robert Wear.', 'doc'],
  ['1970\u20131979', '\u2014', 'Nothing again. No estate, no gazette notice, no grave, no death record in South Africa.', 'gap'],
];
const forCase = [
  ['The DNA excludes Kurt twice over', 'Derrick has 0.0% Ashkenazi Jewish where a son of Kurt Israel Luwinski requires a quarter; and his Y-DNA haplogroup is R-S11477 — R1b, branch U106/Z381, a North Sea lineage, not an Ashkenazi one.'],
  ['The segments require a married couple, not a person', 'Of the 297.5 cM Derrick shares with his closest match, only about 44 fall in regions he also shares with any Castle cousin. The other 253 lie nowhere near them. Two people who share a single ancestor cannot do that. They descend from Henry Robert Wear AND Martha Maud Castle together.'],
  ['That couple had exactly two sons', 'The GRO birth index, searched on the mother’s maiden name, gives six children at Hitchin between 1917 and 1936. Two are sons. In June 1948 one was thirty-one and the other was eleven.'],
  ['The thirty-one-year-old was in Johannesburg', 'Married there in 1940, divorced there in 1951, remarried there the same October, in court there in 1957 and 1962.'],
  ['And a source outside the DNA says he was their son', 'A seven-person MyHeritage tree built in 2018 by his own daughter gives his mother as “Muad Wear, born Castle”. No other record anywhere gives Leonard parents at all.'],
];
const against = [
  ['No document has ever named Leonard as anybody’s father — except his daughter’s tree', 'This is the whole weakness and it has not moved all week. Six South African marriage registers across thirty years and two form designs have now been read, and not one has a column for a parent. The state never asked.'],
  ['Nothing links Leonard to Ivone. Nothing at all.', 'Not a letter, not a witness, not a shared address, not a court paper. The case is that the DNA points at a couple, the couple had two sons, and one of them was a child. It is an argument by elimination, and it is being asked to carry a conclusion about a living man’s parentage.'],
  ['The Berea overlap is thin and must be said to be thin', 'His 1951 address, Polana Court on Abel Road, is a few streets from Ivone’s February 1948 address at 42 Joel Road. But the dates are three and a half years apart and Berea held tens of thousands of people. It is the first geographic overlap this archive has found, and it is not evidence of a meeting.'],
  ['The sibship rests on one search, on one site', 'Six children, from FindMyPast’s birth index searched on a maiden name. It has never been verified against the GRO’s own index or against certificates. If the couple had a seventh child, or if “Bruce W” is not male, the argument changes shape.'],
  ['The index is complete for England and Wales only', 'A son born abroad would not appear in it. The births run continuously at Hitchin from 1917 to 1936, which is why the archive believes the family was there throughout — but that is an inference from the same index.'],
  ['Nobody has tested a Wear Y chromosome', 'Not one. Of 7,748 public members of the R-U106 project, 34 sit under S11477, and no Wear, Weir or Ware is among them.'],
];
const disproof = [
  ['His birth certificate names different parents', 'GRO, Hitchin, first quarter 1917, about £12.50. It names his father and mother outright. This archive has never ordered it, which should be embarrassing, and it is the cheapest decisive document on the entire list.'],
  ['A male-line Wear tests, and does not match R-S11477', 'One Y-37 would do it. The nearest candidate is not a distant cousin: it is Leonard’s own brother, born 1936, who is not recorded as dead in South Africa.'],
  ['His army attestation gives a different next of kin', 'Requested from the SANDF Documentation Centre on 15 September. An attestation form names parents.'],
  ['A third son turns up in the birth index', 'The whole argument is “two sons, and one was eleven”. A third changes the arithmetic.'],
  ['A J294 death notice names a different father', 'The death notices of Gillian Nel and Patricia Grant, requested from the Master of the High Court at Cape Town, each have a field for the father’s full names.'],
  ['Leonard is shown to have been out of the country in 1948', 'Nothing currently places him in Johannesburg between 1941 and 1951 except the fact that he married there before and after.'],
];
---
<Base title="Leonard Aubrey Robert Wear"
  subtitle="Hitchin 1917 — Johannesburg — died 1973 or 1979, and this archive cannot say which"
  lede="The man the DNA points at. He has never had a page here, because until 15 September 2026 there was almost nothing to put on one: a birth index entry, a census line at the age of four, and somebody else's family tree. There is more now — an occupation, two marriages read in full, three court files and an address — and there is still no document that joins him to Derrick.">

  <div class="panel">
    <h3>Read this part first <span class="tag inf">Standing</span></h3>
    <p>
      <strong>Leonard Aubrey Robert Wear is an inference, not a finding.</strong> Everything on this
      page about <em>his own life</em> is documented and cited. Everything about <em>his relationship
      to Derrick</em> rests on an argument from shared DNA segments and a sibling list, and on no
      document whatsoever.
    </p>
    <p>
      The case against him is set out below at the same length as the case for him, and it is not
      padding. If you read only one half, read that one.
    </p>
  </div>

  <h2>His life, as far as it is documented</h2>
  <div class="scroll bleed"><table>
    <thead><tr><th>When</th><th>What</th><th></th></tr></thead>
    <tbody>{life.map(([d, e, n, k]) => (
      <tr>
        <td><strong>{d}</strong></td>
        <td>{e} {k === 'doc' && <span class="tag doc">Documented</span>}{k === 'inf' && <span class="tag inf">Inferred</span>}{k === 'disp' && <span class="tag disp">Disputed</span>}</td>
        <td class="small muted">{n}</td>
      </tr>
    ))}</tbody>
  </table></div>
  <p class="small muted">
    The two marriage registers were read from microfilm at full resolution on 15 September 2026:
    <a class="src" href={fs('1:1:6ZCM-N8BV')}>1940, certificate 13</a> and
    <a class="src" href={fs('1:1:6ZHR-R9ZG')}>1951, certificate 1397</a>.
  </p>

  <h2 id="where">Where he can be put, and where he cannot</h2>
  <p>
    Fifty-eight years of a life, and <strong>three addresses</strong>. They are set out here with the
    silences at the same weight as the entries, because the silences are the point.
  </p>
  <div class="scroll bleed"><table>
    <thead><tr><th>When</th><th>Where</th><th></th></tr></thead>
    <tbody>{where.map(([w, a, n, k]) => (
      <tr>
        <td><strong>{w}</strong></td>
        <td>{k === 'gap' ? <span class="muted">{a}</span> : <strong>{a}</strong>}
          {k === 'inf' && <> <span class="tag inf">Inferred</span></>}
          {k === 'gap' && <> <span class="tag open">Silent</span></>}</td>
        <td class="small muted">{n}</td>
      </tr>
    ))}</tbody>
  </table></div>
  <div class="panel">
    <h3>The last certain sighting <span class="tag doc">15 September, late</span></h3>
    <p>
      Every other line in that table comes from a marriage register or a court index. This one comes
      from a cemetery ledger, and it is the only record outside a family tree that puts
      <strong>Leonard and Henry Robert Wear on the same document</strong>.
    </p>
    <blockquote class="small">
      <strong>West Park Cemetery, City of Johannesburg — Private Graves Register, folio W 8</strong><br />
      Name of purchaser: <strong>WEAR, Mr. L. A. R.</strong> &middot; Address:
      <strong>271, Wilson St., Fairlands, J&rsquo;hb.</strong><br />
      Receipt 11484 &middot; purchased <strong>13.9.69</strong> &middot; <strong>&pound;60</strong><br />
      Buried 13.9.69 &middot; grave <strong>56045</strong> &middot; section E.C. &middot;
      person buried <strong>Henry Robert Wear</strong>
    </blockquote>
    <p>
      Read at five times magnification, the first initial is a cursive <strong>L</strong>, not a J
      &mdash; the ascender and bowl are unmistakable beside the <em>J</em> forms elsewhere on the page.
    </p>
    <p>
      <strong>What it is not.</strong> The register records a <em>purchaser</em>, not a relationship.
      It proves that an L. A. R. Wear buried Henry Robert Wear and paid sixty pounds to do it. This
      archive knows of no other L. A. R. Wear &mdash; but that is an absence, not a proof, and the
      page will not call it more than it is.
    </p>
    <p>
      <strong>What it is.</strong> A fourth address, and the last certain sighting of him:
      <strong>alive, in Johannesburg, on 13 September 1969.</strong> Seventeen years later his mother
      was buried in that same grave, 56045, section EC &mdash; the parents lie together in a plot
      their elder son paid for.
    </p>
    <p class="small muted">
      <strong>Correction, 15 September:</strong> this archive first published the folio as
      <strong>W58</strong>. It is <strong>W 8</strong>. Re-cropped and read on its own at 4.3&times;,
      the pencilled head-margin number is a looped <em>W</em> and a single <em>8</em>; the flourish
      on the W had been read as a 5. Three records agree &mdash; the purchaser page&rsquo;s own head
      margin, the index side of the same folio, and the burial register&rsquo;s cross-reference
      <em>&ldquo;P. Fol. W.8.&rdquo;</em> Nothing else in the entry changes. But published wrong, it
      would have sent the next researcher to the wrong sheet.
    </p>
  </div>

  <div class="panel">
    <h3>His father&rsquo;s own address, and his own, on the same day <span class="tag doc">15 September, later</span></h3>
    <p>
      The grave register gave the purchaser. The <strong>burial</strong> register &mdash; folio W 56 of
      the same cemetery&rsquo;s books, the folio the grave register points to &mdash; gives the dead
      man&rsquo;s household. Row 4, read at up to five times magnification:
    </p>
    <blockquote class="small">
      <strong>Wear &middot; Henry Robert</strong> &middot; buried <strong>13.9.69</strong> &middot;
      grave <strong>5604/5</strong> &middot; section E.C. &middot; M &middot; aged <strong>80</strong><br />
      Address at time of death: <strong>General Hospital, Jhb.</strong><br />
      Usual residence: <strong>5 Livingstone Ct., 4th St., Parkhurst, Jhb.</strong><br />
      Died <strong>11.9.69</strong> of <strong>bronchopneumonia</strong> &middot; burial order 2894 &middot;
      undertaker Cooks &middot; R15.00
    </blockquote>
    <p>
      <strong>On the day he bought the grave, Leonard&rsquo;s address and his father&rsquo;s were not
      the same address.</strong> Henry Robert Wear&rsquo;s household was a flat in Parkhurst.
      Leonard&rsquo;s was 271 Wilson Street, Fairlands, a mile and a half away.
    </p>
    <p>
      That is neutral on paternity &mdash; a fifty-two-year-old man twice divorced would not be living
      with his parents. What it does is make the Fairlands address <em>his</em> rather than a borrowed
      family one, and an address of a man&rsquo;s own is the kind of thing deeds, voters rolls and
      street directories can be run against. <span class="tag open">Next</span>
    </p>
    <p>
      It also demotes an inference this archive has been leaning on. <strong>64 Greenfield Road,
      Greenside</strong> was never documented as the parents&rsquo; house &mdash; it was reasoned from an
      unmarried daughter of twenty-one in 1952. The parents are now documented in
      <strong>Parkhurst</strong> in 1969, and the widow still in Parkhurst in 1986, two streets away.
      Greenside survives as a guess bracketed by two facts, and the page should say so.
    </p>
  </div>

  <div class="panel">
    <h3>The family never took South African citizenship <span class="tag doc">15 September, later still</span></h3>
    <p>
      The Parkhurst address was one clerk&rsquo;s handwriting. Run against the Government Gazette it
      came back twice over, and the second record is worth more than the address it confirms.
    </p>
    <blockquote class="small">
      <strong>Government Gazette 4620, 21 March 1975</strong> &mdash; <em>Naturalization Notices</em><br />
      EVANS, Mrs <strong>Janette Eileen Maud</strong>, formerly <strong>Bailey</strong>,
      n&eacute;e <strong>Wear</strong>, saleslady,
      <strong>5 Livingstone Court, 28 Fourth Street, Parkhurst, Johannesburg</strong>
    </blockquote>
    <blockquote class="small">
      <strong>Government Gazette 5007, 12 March 1976</strong> &mdash; certificates issued<br />
      <strong>R54033</strong> &mdash; EVANS, Janette Eileen Maud, <strong>28/10/19</strong>,
      <strong>England</strong>, Citizen of the U.K. and C., <strong>30/10/75</strong>
    </blockquote>
    <p>
      She is Leonard&rsquo;s eldest sister &mdash; GRO birth index Q4 1919 at Hitchin, mother&rsquo;s
      maiden name Castle; the 1921 census at 72 Pix Road; the 1939 Register still at Letchworth — where, it turns out, she was waiting to be married. The
      naturalisation record gives her birth as <strong>28 October 1919</strong>, which falls inside
      that GRO quarter. The archive did not have to assume the identification.
    </p>
    <p>
      <strong>Two things follow, and the second is the one that matters.</strong>
    </p>
    <p>
      <strong>The address is corroborated.</strong> A cemetery clerk&rsquo;s hand in 1969 and the
      Government Printer&rsquo;s type in 1975 give the same flat, and the gazette adds the
      building&rsquo;s street number. Their mother was still in Parkhurst in 1986, two streets away.
    </p>
    <p>
      <strong>They stayed British.</strong> The eldest daughter was still a citizen of the United
      Kingdom and Colonies in 1975 &mdash; <strong>forty years after the household left
      Hertfordshire.</strong> This family did not naturalise on arrival. It explains something this
      archive had been treating as a mystery: why a man who lived in Johannesburg from the late
      1930s until at least 1969 leaves so little in South African government series. A British
      subject resident in the Union generates fewer of them.
    </p>
    <p>
      It also opens a record class the archive has never used. A gazette notice is a name and an
      address; the <strong>naturalisation file</strong> behind it records birth, previous
      nationality and <strong>parents</strong>. The South African civil marriage registers have no
      parentage field at all &mdash; this series does. <span class="tag open">Next</span>
    </p>
    <p class="small muted">
      <strong>What this is not.</strong> A phrase search of the gazette returns nothing for
      &ldquo;Leonard Aubrey Robert&rdquo;, and no Wear at all in either the 1975 notice list or the
      1976 grant list. That is suggestive and no more. The lists are alphabetical, the OCR
      interleaves two columns badly enough that this entry had to be unpicked from its neighbour,
      and one surviving name proves only that a name <em>can</em> survive. It is not an exhaustive
      sweep and this page does not call it one.
    </p>
  </div>

  <div class="panel">
    <h3>One of the two death years has now failed a test <span class="tag doc">15 September, last</span></h3>
    <p>
      This page has always said <em>died 1973 or 1979, and this archive cannot say which</em>. The
      family tree gives 1973; GenDatabase gives 1979; nothing has ever separated them. Something
      does now, and it is not a document &mdash; it is the shape of an index.
    </p>
    <p>
      The National Archives of South Africa index, NAAIRS, was driven directly rather than through a
      commercial mirror. It holds no deceased estate for Leonard Aubrey Robert Wear. An absence is
      worth nothing until the index&rsquo;s reach is known, so the reach was measured:
    </p>
    <table class="small">
      <thead><tr><th>Year</th><th>Deceased-estate records in NAAIRS</th></tr></thead>
      <tbody>
        <tr><td>1976</td><td><strong>2,246</strong></td></tr>
        <tr><td>1977</td><td>1</td></tr>
        <tr><td>1978</td><td>0</td></tr>
        <tr><td>1979</td><td>0</td></tr>
        <tr><td>1980</td><td>0</td></tr>
      </tbody>
    </table>
    <p>
      <strong>The estate index runs to the end of 1976 and stops.</strong> Which makes the two years
      asymmetric for the first time.
    </p>
    <p>
      <strong>1973 is inside the index.</strong> A death in South Africa in 1973 leaving any estate
      would be in it. It is not &mdash; and there is no Wear deceased estate in the Transvaal at all
      between 1970 and 1976. The last one is his father&rsquo;s, MHG 10245/69.
    </p>
    <p>
      <strong>1979 falls three years past the index&rsquo;s last year</strong> and cannot be tested
      this way at all.
    </p>
    <p>
      <strong>This does not prove 1979.</strong> He could have died in 1973 outside South Africa, or
      left too little to report, or the index could have gaps this archive has not measured. But
      1973 is now a claim that has been looked for where it should be and is not there, and 1979 is
      a claim nobody has been able to look for. <strong>They are no longer equal.</strong>
    </p>
  </div>

  <div class="panel">
    <h3>A fifth court file, and the woman his second marriage ended over</h3>
    <p>
      The same index gave two things the archive did not have.
    </p>
    <blockquote class="small">
      <strong>WLD 978/1960</strong> &mdash; Illiquid case. Payment.
      <strong>Mawthane Dabeah Kwele versus L. A. R. Wear.</strong>
    </blockquote>
    <p>
      <strong>A new year.</strong> Leonard was in Johannesburg in 1960 and somebody sued him for
      money. The plaintiff&rsquo;s name is African; a Black plaintiff bringing a payment action
      against a white defendant in that court in 1960 implies a working or trading relationship
      rather than a casual one, and the archive will not guess further than that. The file would say.
    </p>
    <blockquote class="small">
      <strong>WLD 2960/1962</strong> &mdash; Divorce. Marjorie Eileen Wear (formerly Dunlop, born
      Walker) v. <strong>Leonard Aubrey Robert</strong>.<br />
      <strong>WLD 2961/1962</strong> &mdash; Damages. Marjorie Eileen Wear (formerly Dunlop, born
      Walker) v. <strong>a named woman</strong>.
    </blockquote>
    <p>
      Same plaintiff, consecutive numbers, same year. A wife suing her husband for divorce and
      another woman for damages in the same breath is, in the practice of the period, an action
      against the co-respondent. <strong>His second marriage very probably ended over somebody</strong>,
      and the National Archives index names her. <span class="tag open">Next</span>
    </p>
    <p class="small muted">
      <strong>Her name is in the index and not on this page.</strong> She would be in her eighties or
      nineties if she is alive, the archive has no death record for her, and the claim being made
      about her is an imputation of adultery drawn from two case numbers rather than from the file.
      This archive does not publish that about someone who may be living. The reference
      &mdash; WLD 2961/1962, Witwatersrand Local Division &mdash; is public and complete, and anybody
      entitled to order the file can.
    </p>
    <p class="small muted">
      Stated, too, as the structural inference it is. The index entry does not say adultery and the
      file has not been opened. But 2960 and 2961 were filed together, and only one reading makes
      sense of that.
    </p>
  </div>

  <div class="panel">
    <h3>He did not go into the grave he bought <span class="tag doc">15 September, overnight</span></h3>
    <p>
      The archive reached grave 56045 by following his father, then his mother. It had never asked
      the flatter question: <strong>how many Wears are in Johannesburg&rsquo;s ground at all?</strong>
      Searched by collection rather than by name-guessing &mdash; 517 raw hits on the surname,
      collapsed to distinct people:
    </p>
    <div class="scroll"><table class="small">
      <thead><tr><th>Name</th><th>Buried</th></tr></thead>
      <tbody>
        <tr><td>Henrietta Wear</td><td>15 September 1909</td></tr>
        <tr><td><strong>Henry Robert Wear</strong></td><td><strong>13 September 1969</strong> &mdash; grave 56045</td></tr>
        <tr><td><strong>Martha Maud Wear</strong></td><td><strong>19 March 1986</strong> &mdash; the same grave</td></tr>
        <tr><td>Edwina Ann Wear</td><td>8 July 2014</td></tr>
        <tr><td>Michelle Ann Wear, born 1978</td><td>27 March 2017</td></tr>
        <tr><td>Dan B Wear</td><td>no date recorded</td></tr>
      </tbody>
    </table></div>
    <p>
      <strong>Leonard is not among them.</strong> He paid sixty pounds for his father&rsquo;s grave in
      September 1969 and he was not buried in it &mdash; and he is in no other Johannesburg cemetery
      register the collection indexes, under any spelling of his forenames.
    </p>
    <p class="small muted">
      <strong>The bounds.</strong> This is the indexed layer of one collection covering 1840&ndash;2019.
      It does not cover images inside it that were never indexed, other Johannesburg cemeteries, or
      the Chevrah Kadisha &mdash; a separate database, and the one that holds Kurt, Pauline and
      Salkow. A Wear would have no business in a Jewish cemetery, but the exclusion is stated rather
      than assumed. Every absence this archive relies on is set out with its limits on the
      <a href={base + '/negatives/'}>bounded negatives</a> page.
    </p>
  </div>

  <div class="panel">
    <h3>Marjorie, and the second line on the Y <span class="tag doc">16 September</span></h3>
    <p>
      The archive knew his second wife only as a name on a register. She is now documented from 1949
      to her death, and she is the best-recorded person in his orbit.
    </p>
    <div class="scroll"><table class="small">
      <thead><tr><th>When</th><th>What</th></tr></thead>
      <tbody>
        <tr><td>1916</td><td>Marjorie Eileen <strong>WALKER</strong> is born</td></tr>
        <tr><td><strong>1949</strong></td><td><strong>WLD 185/1949</strong> &mdash; she divorces <strong>Robert John Dunlop</strong></td></tr>
        <tr><td><strong>30 Oct 1951</strong></td><td><strong>She marries Leonard</strong>, at Polana Court, Abel Road, Berea</td></tr>
        <tr><td>1962</td><td><strong>WLD 2960/1962</strong> &mdash; she divorces him; <strong>WLD 2961/1962</strong>, one number later, sues another woman for damages</td></tr>
        <tr><td>1973</td><td><strong>WLD 2276/1973</strong> and <strong>7613/1973</strong> &mdash; Roger William Hannay <strong>Humphrey</strong> against her</td></tr>
        <tr><td><strong>2003</strong></td><td>She dies as <strong>Marjorie Eileen Humphrey, born Walker</strong> &mdash; and there is an <strong>estate file</strong></td></tr>
      </tbody>
    </table></div>
    <p>
      <strong>Her divorce and his are two years apart.</strong> She came out of the Dunlop marriage in
      1949; his own divorce from Phyllis is WLD 2026/1951. Two people leaving two marriages, married
      to each other in the middle of 1951. <strong>The archive&rsquo;s blank nine years end exactly
      where her paper trail begins</strong> &mdash; and 1948 sits immediately before her divorce.
    </p>
    <p>
      <strong>And her estate may end the Y problem.</strong> She was married to Leonard for eleven
      years, the longest documented relationship of his life. An estate&rsquo;s next-of-kin and heirs
      schedule lists the deceased&rsquo;s children. <strong>If she had a son by him, that son carries
      Leonard&rsquo;s own Y chromosome</strong> &mdash; and he would be in his seventies, not ninety,
      which is the age of the brother this archive has been waiting on.
      <span class="tag open">Next</span>
    </p>
    <p class="small muted">
      Stated carefully, because it would be easy to get ahead of this. <strong>Nobody knows whether
      there were children of that marriage.</strong> This archive has never seen a birth, and eleven
      years without issue is perfectly ordinary. But the schedule is the cheapest place to find out,
      and until now nobody had a reason to look.
    </p>
  </div>

  <div class="panel">
    <h3>He did not go home to die <span class="tag doc">16 September</span></h3>
    <p>
      Finding that the family never naturalised raised a possibility this archive had never
      entertained: that a man still legally British in the 1970s, twice divorced, with no South
      African estate, <strong>went back to England.</strong> He did not, and the negative is the
      cleanest one on this page.
    </p>
    <p>
      <strong>Searched: surname WEAR, deaths, England and Wales, March 1970 to December 1985, no
      forename given.</strong> Two hundred and forty-one entries across fifty-eight consecutive
      quarters, <strong>every one marked more than 99 per cent complete.</strong> Sixteen of the 241
      were born between 1915 and 1919.
    </p>
    <p>
      <strong>Not one of them is him.</strong> The only 1917 birth in the whole range is a Sam Wear
      of Halifax. Searching the forename instead returns exactly one man &mdash; Leonard Rigby Wear,
      born 10 October 1897, died at Claro in June 1970 &mdash; twenty years too old and from the
      wrong county.
    </p>
    <p>
      <strong>The reason this one is worth trusting</strong> is that from 1969 the death index prints
      the <em>full forenames and the date of birth</em>. He could hide behind neither an initial nor
      a common surname.
    </p>
    <p>
      <strong>Which sharpens the question rather than answering it.</strong> Three instruments have
      now looked in three different places and found nothing: the South African estate index to 1976,
      the Johannesburg cemetery registers, and the England and Wales death index. GenDatabase&rsquo;s
      1979 &mdash; the record it marks <em>incomplete</em>, with a corrupt birth field &mdash; is now
      <strong>the only positive record of his death anywhere</strong>, and the family tree&rsquo;s
      1973 has failed three separate tests.
    </p>
    <p class="small muted">
      What this does not cover, stated because the <a href={base + '/negatives/'}>bounded negatives</a>
      page exists for exactly this: deaths <em>abroad</em>, which are registered in the GRO&rsquo;s
      consular and overseas series and have not been searched; and Scotland and Northern Ireland,
      which keep their own registers. The consular registers are where a British subject dying in
      Johannesburg would be recorded, and they are now the most important untested thing about him.
      <span class="tag open">Next</span>
    </p>
  </div>

  <div class="panel">
    <h3>His sister did not stay behind. She stayed to be married. <span class="tag doc">16 September</span></h3>
    <p>
      The 1939 Register, taken on <strong>29 September 1939</strong>, found one Wear still in
      Hertfordshire &mdash; <em>Jeannett (E M) Wear, 1919, 18 Ridge Avenue, Letchworth</em> &mdash;
      while the rest of the household had already gone. This archive read that as a girl of twenty
      left behind. It has now found what she was doing:
    </p>
    <blockquote class="small">
      <strong>Marriages, December quarter 1939</strong> &mdash; <strong>HITCHIN</strong>, vol 3a, page 4416<br />
      <strong>WEAR, Jeanette E M</strong> &mdash; spouse <strong>BAILEY</strong><br />
      <strong>BAILEY, Edward J</strong> &mdash; spouse <strong>WEAR</strong>
    </blockquote>
    <p>
      <strong>She married Edward Bailey within three months of that register, and probably less</strong>
      &mdash; at Hitchin, the district where all six Wear children were born. She was not abandoned.
      She was waiting for a wedding.
    </p>
    <p>
      <strong>And it opens a door this archive had given up on.</strong> The South African marriage
      register has no parents&rsquo; column at all &mdash; that single fact is why the whole Wear
      sibship rests on a seven-person family tree, and why three separate requests are out chasing
      estates and naturalisation files. <strong>An English marriage certificate names both
      fathers.</strong>
    </p>
    <p>
      If Hitchin 3a/4416 names <strong>Henry Robert Wear</strong>, then this archive has an official
      record &mdash; not a tree &mdash; that he had a daughter born at Hitchin in 1919.
      <strong>It costs about &pound;14 and arrives by email.</strong> It does not prove Leonard was
      his son. It removes the tree as the only authority for the couple at the head of this line,
      which is what the slow and expensive requests are for. <span class="tag open">Next</span>
    </p>
  </div>

  <div class="panel">
    <h3>The nine years that matter are the nine years that are blank</h3>
    <p>
      He is at a military camp outside Pretoria in September 1940. He is at a block of flats in Berea
      in October 1951. <strong>Between those two points there is one recorded fact — that a daughter
      was born in 1941 — and no address whatsoever.</strong>
    </p>
    <p>
      <strong>1948 is in the middle of that hole.</strong> Nothing places Leonard in Johannesburg in
      1948 except the fact that he married there in 1940 and again in 1951. That is an inference from
      either side of a gap, and this page will not dress it up as anything else.
    </p>
    <p class="small">
      What would fill it: Johannesburg <strong>street and telephone directories</strong>, which ran
      annually and are not online; the <strong>Deeds Office</strong> property index; and the
      <strong>voters rolls</strong>. All three need somebody in Johannesburg or Pretoria. None of them
      needs a fee worth arguing about. <em>This is the cheapest unworked lead in the archive.</em>
    </p>
  </div>


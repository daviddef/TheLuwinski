---
import Base from "../../../layouts/Base.astro";
import ResearchList from "../../../components/ResearchList.astro";
import { u } from "../../../lib/url.js";
import { RESEARCH } from "../../../lib/research-menu.js";
const g = RESEARCH.find((x) => x.id === "to-do");
---
<Base title="To do" subtitle="Research · what is not done yet" lede={g.dek}>
  <section>
    <ResearchList items={g.items} />
    <p class="small muted" style="margin-top:1.4rem">The rest of Research: <a href={u("/whats-new/")}>What's new</a> · <a href={u("/research/sources-and-method/")}>Sources &amp; method</a> · <a href={u("/research/")}>all of it on one page</a>.</p>
  </section>
</Base>

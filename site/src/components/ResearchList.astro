---
/* A list of Research pages with what each one asks, and a live count where the archive can state one. Used by /research/ and by the
   group pages, so the three read alike. 12 November 2026 (the research-menu pattern). */
import { u } from "../lib/url.js";
import { blurbOf } from "../lib/research-counts.js";
const { items } = Astro.props;
---
<ul class="rl">
  {items.map((x) => (
    <li>
      <a class="rl-t" href={u(x.href + "/")}>{x.label}</a>
      {x.atlas && <span class="rl-a" title="Part of what this page records is also on the Record Atlas">also on the Atlas</span>}
      <span class="rl-n" set:html={blurbOf(x)}></span>
    </li>
  ))}
</ul>
<style>
  .rl { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; max-width: none; }
  .rl li { border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 3px; padding: 12px 16px; margin: 0; }
  .rl-t { font-weight: 600; font-size: 1.05rem; }
  .rl-a { margin-left: 10px; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; opacity: .62; border: 1px solid currentColor; border-radius: 2px; padding: 1px 6px; }
  .rl-n { display: block; margin-top: 4px; font-size: .92rem; line-height: 1.55; opacity: .85; }
</style>

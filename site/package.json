{
  "name": "luwinski-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4331",
    "build": "npm run check:pin && npm run build:register && npm run build:names && npm run build:given && npm run build:evidence && npm run build:records && astro build && npm run autolink && npm run check:templates && python3 ../tools/build-search.py && npm run check:search && npm run sitemap && npm run check:book && npm run check:living && npm run check:prose && npm run check:families && npm run check:lines && npm run check:worklist && npm run check:covers && npm run check:matches && npm run check:evidence && npm run check:superseded && npm run check:sources && npm run check:pages && npm run check:inline && npm run check:rows && npm run check:nav && npm run check:links && npm run check:standard",
    "preview": "astro preview --port 4331",
    "check:search": "python3 ../tools/check-search.py",
    "check:living": "python3 ../tools/check-living.py --dist dist --mode harvest && python3 ../tools/check-living.py --dist dist --mode hashes && python3 ../tools/selftest-living.py --dist dist",
    "check:prose": "python3 ../tools/check-prose.py",
    "check:families": "python3 ../tools/check-families.py --dist dist && python3 ../tools/check-families.py --dist dist --selftest",
    "check:lines": "python3 ../tools/check-lines.py --dist dist && python3 ../tools/check-lines.py --dist dist --selftest",
    "check:prose-strict": "python3 ../tools/check-prose.py --require-tree",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:matches": "python3 ../tools/check-matches.py --strict",
    "build:register": "python3 ../tools/build-register.py",
    "build:names": "python3 ../tools/build-names-index.py",
    "build:given": "python3 ../tools/build-given-names.py",
    "check:names": "python3 ../tools/build-names-index.py --check",
    "autolink": "python3 ../tools/build-living-list.py && python3 node_modules/@daviddef/archive-kit/kit/tools/autolink.py --dist dist --index src/data/names-index.json --living ../private/living.json --allow-prefix /people/ --allow-prefix /search/",
    "check:links": "python3 node_modules/@daviddef/archive-kit/kit/tools/checklinks.py --dist dist --index src/data/names-index.json --living ../private/living.json --allow-prefix /people/ --allow-prefix /search/ --floor .linkfloor.json",
    "floor:links": "python3 node_modules/@daviddef/archive-kit/kit/tools/checklinks.py --dist dist --index src/data/names-index.json --living ../private/living.json --allow-prefix /people/ --allow-prefix /search/ --floor .linkfloor.json --write-floor && python3 ../tools/strip-linkfloor.py",
    "check:standard": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkstandard.py --dist dist --index src/data/names-index.json --config standard.json --living ../private/living.json --floor .standardfloor.json --strict-config",
    "floor:standard": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkstandard.py --dist dist --index src/data/names-index.json --config standard.json --living ../private/living.json --floor .standardfloor.json --strict-config --write-floor",
    "selftest:standard": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkstandard_selftest.py",
    "build:evidence": "python3 ../tools/build-evidence.py",
    "build:records": "python3 ../tools/build-records.py",
    "check:records": "python3 ../tools/build-records.py --check",
    "check:evidence": "python3 ../tools/check-evidence.py",
    "check:superseded": "python3 ../tools/check-superseded.py",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:sources": "python3 node_modules/@daviddef/archive-kit/kit/tools/checksources.py --root . --max-unreachable 6",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 1",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 13",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root ."
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#772de52e89c582c0c69b315a7911125b13c773a3",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}

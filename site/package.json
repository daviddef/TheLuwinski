{
  "name": "luwinski-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4331",
    "build": "npm run build:register && npm run build:evidence && astro build && npm run check:templates && python3 ../tools/build-search.py && npm run check:search && npm run check:living && npm run check:worklist && npm run check:covers && npm run check:matches && npm run check:evidence",
    "preview": "astro preview --port 4331",
    "check:search": "python3 ../tools/check-search.py",
    "check:living": "python3 ../tools/check-living.py --dist dist --mode harvest && python3 ../tools/check-living.py --dist dist --mode hashes",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:matches": "python3 ../tools/check-matches.py",
    "build:register": "python3 ../tools/build-register.py",
    "build:evidence": "python3 ../tools/build-evidence.py",
    "check:evidence": "python3 ../tools/check-evidence.py",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root ."
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#86f3b60926f1d4c2aef72e433d539cba479efdd7",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}

{
  "name": "luwinski-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4331",
    "build": "npm run build:register && npm run build:evidence && astro build && python3 ../tools/build-search.py && npm run check:living && npm run check:worklist && npm run check:covers && npm run check:matches && npm run check:evidence",
    "preview": "astro preview --port 4331",
    "check:living": "python3 ../tools/check-living.py --dist dist",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:matches": "python3 ../tools/check-matches.py",
    "build:register": "python3 ../tools/build-register.py",
    "build:evidence": "python3 ../tools/build-evidence.py",
    "check:evidence": "python3 ../tools/check-evidence.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#2589343bb340a87e339a18e8e1e88343998647d6",
    "astro": "^5.18.2"
  }
}

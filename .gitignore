node_modules/
site/node_modules/
site/dist/
# private verification builds — ARCHIVE_OUT targets, never committed.
# A shared name (dist-verify) recreates the collision it was meant to solve,
# so these are per-process (dist-gate-$$) and the glob covers both.
site/dist-*/
site/.astro/
.DS_Store
*.log
scratch/

# The raw harvest holds every living person in full, and the working notes name
# living DNA match holders. Neither belongs in a public repository. The build
# needs only site/src/data/register.json, which is generated from the harvest
# with living people already removed.
data/myheritage-tree9.json
# The AutoClusters export names 110 living DNA match holders with their
# cM and their tree links. Same rule as the harvest: it never leaves this machine.
data/autoclusters-*.csv
notes/
site/public/searchindex.json

# The prose gate's feed holds living people's names (tools/build-checkprose-feed.py writes it here, mode 0600).
# It is rebuilt on every run and never committed.
private/

# The given-name vocabulary for the linking standard: derived from the committed register in every build and in CI
# (tools/build-given-names.py), never committed, so no stale copy can drift from the register.
site/given.json
